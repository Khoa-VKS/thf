        # Tab 1: Danh sách 12 cột chuẩn hóa
        self.tab_table = tk.Frame(self.notebook, bg="#FFFFFF")
        self.notebook.add(self.tab_table, text="📋 Danh Sách 12 Cột Chuẩn Hóa (Bao gồm Tỉnh/Thành)")
