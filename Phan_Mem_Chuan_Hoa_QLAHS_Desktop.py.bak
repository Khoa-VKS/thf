from datetime import datetime, date

def parse_date_safely(val):
    """Chuyển đổi chuỗi ngày tháng sang đối tượng date chuẩn an toàn."""
    if not val:
        return None
    val_s = str(val).strip()
    if not val_s:
        return None
    for fmt in ('%d/%m/%Y', '%Y-%m-%d', '%d-%m-%Y', '%d/%m/%y'):
        try:
            return datetime.strptime(val_s, fmt).date()
        except ValueError:
            pass
    return None

