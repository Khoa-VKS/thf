              ⚖️ 4. Giai đoạn × Trạng thái
            </button>
          </div>

          <!-- Pivot Configuration Selectors -->
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="text-slate-600 font-bold">Trục Dòng:</span>
            <select id="pivotRowSelect" class="px-2.5 py-1.5 rounded-xl border border-slate-300 bg-white font-bold text-slate-800 text-xs shadow-sm">
              <option value="tinhThanh">Tỉnh / Thành phố</option>
