    <!-- ========================================================================= -->
    <!-- TAB 3: ĐỐI CHIẾU CẤU TRÚC GỐC (5 CỘT NHIỀU DÒNG -> 12 CỘT CHUẨN)         -->
    <!-- ========================================================================= -->
    <section id="viewCompare" class="hidden space-y-4">
      <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm space-y-4">
        <div>
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full bg-blue-100 text-blue-900 font-black text-xs">VKSND TP. Hồ Chí Minh</span>
            <h2 class="text-base font-bold text-slate-900">Quy tắc nhận diện Tỉnh/Thành &amp; bóc tách tự động từ dữ liệu NTQLAHS</h2>
          </div>
          <p class="text-xs text-slate-600 mt-1 leading-relaxed">
            Khi copy từ phần mềm Quản lý án hình sự (NTQLAHS) dán xuống Excel, mỗi hồ sơ bị tách thành 3–5 dòng rời nhau. Hệ thống sử dụng mốc neo <code class="bg-slate-100 px-1.5 py-0.5 rounded font-semibold text-blue-800">Giai đoạn: ...</code> ở cột B để gom nhóm từng khối hồ sơ, đồng thời sử dụng bộ từ điển 63 tỉnh/thành phố để tự động nhận dạng chính xác địa phương thụ lý:
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
          <!-- Bảng 1: Dữ liệu thô -->
          <div class="border border-slate-200 rounded-xl p-4 bg-slate-50">
            <h3 class="font-bold text-slate-900 mb-2 flex items-center gap-1.5">
              <span class="w-4 h-4 rounded-full bg-slate-300 text-slate-800 flex items-center justify-center text-[10px] font-bold">1</span>
              Dữ liệu thô khi copy từ phần mềm NTQLAHS (5 cột × 4 dòng / hồ sơ)
            </h3>
            <div class="overflow-x-auto bg-white border border-slate-300 rounded-lg">
              <table class="w-full text-[11px] border-collapse">
                <thead>
                  <tr class="bg-slate-200 text-slate-800 font-semibold">
                    <th class="border border-slate-300 p-1.5">A (STT)</th>
                    <th class="border border-slate-300 p-1.5">B (Thông tin hồ sơ)</th>
                    <th class="border border-slate-300 p-1.5">C (Họ tên)</th>
                    <th class="border border-slate-300 p-1.5">D (Tội danh)</th>
                    <th class="border border-slate-300 p-1.5">E (Trạng thái)</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td class="border border-slate-200 p-1.5 text-slate-400"></td>
                    <td class="border border-slate-200 p-1.5 text-teal-700 font-medium">Giai đoạn: Sơ thẩm</td>
                    <td class="border border-slate-200 p-1.5 text-blue-800 underline">VA_E01.59.010_2606_0090_001</td>
                    <td class="border border-slate-200 p-1.5 text-slate-400"></td>
                    <td class="border border-slate-200 p-1.5 text-slate-400"></td>
                  </tr>
                  <tr>
                    <td class="border border-slate-200 p-1.5 text-slate-400"></td>
                    <td class="border border-slate-200 p-1.5 text-blue-800 underline">VA_E01.59.010_2606_0090</td>
                    <td class="border border-slate-200 p-1.5 font-bold">Nguyễn Ngọc Lài</td>
                    <td class="border border-slate-200 p-1.5 text-slate-400"></td>
                    <td class="border border-slate-200 p-1.5 text-slate-400"></td>
                  </tr>
                  <tr>
                    <td class="border border-slate-200 p-1.5 text-center font-bold">2</td>
                    <td class="border border-slate-200 p-1.5 font-bold">Nguyễn Ngọc Lài. Đ138</td>
                    <td class="border border-slate-200 p-1.5">Ngày sinh: 20/12/1985</td>
                    <td class="border border-slate-200 p-1.5">Điều 138 - Tội trộm cắp tài sản</td>
                    <td class="border border-slate-200 p-1.5 text-amber-800 font-semibold">Đình nã</td>
                  </tr>
                  <tr>
                    <td class="border border-slate-200 p-1.5 text-slate-400"></td>
                    <td class="border border-slate-200 p-1.5 text-sky-800 font-semibold bg-sky-50">Công an tỉnh Hà Tĩnh</td>
                    <td class="border border-slate-200 p-1.5">CCCD: 000000000003</td>
                    <td class="border border-slate-200 p-1.5 text-slate-400"></td>
                    <td class="border border-slate-200 p-1.5 text-slate-400"></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Bảng 2: Ánh xạ 12 cột -->
          <div class="border border-blue-200 rounded-xl p-4 bg-blue-50/40 space-y-2">
            <h3 class="font-bold text-blue-950 mb-2 flex items-center gap-1.5">
              <span class="w-4 h-4 rounded-full bg-blue-600 text-white flex items-center justify-center text-[10px] font-bold">2</span>
              Sơ đồ ánh xạ sang 12 cột chuẩn hóa và phân tích
            </h3>
            <ul class="space-y-1.5 text-slate-700 text-xs">
              <li><span class="font-semibold text-slate-900">• Cột 1 (STT):</span> Số thứ tự của hồ sơ bị can.</li>
              <li><span class="font-semibold text-slate-900">• Cột 2 (Mã vụ án):</span> Dòng thứ 2 của cột B (<code class="bg-white px-1 rounded">VA 010214...</code>).</li>
              <li><span class="font-semibold text-slate-900">• Cột 3 (Tên vụ án):</span> Dòng tên vụ án in đậm của cột B.</li>
              <li><span class="font-semibold text-slate-900">• Cột 4 (Cơ quan CSĐT):</span> Dòng CQĐT (<code class="bg-white px-1 rounded">Công an Thành phố Hồ Chí Minh</code>, <code class="bg-white px-1 rounded">Công an tỉnh Hà Tĩnh</code>).</li>
              <li class="p-1.5 rounded-lg bg-amber-100 border border-amber-300 text-amber-950 font-bold">
                <span class="text-red-800">★ Cột 5 (Tỉnh / Thành phố - MỚI):</span> Tự động phân tích từ chuỗi CQĐT để trích xuất chuẩn hóa: <code class="bg-white px-1.5 py-0.5 rounded text-blue-900 font-black">TP. Hồ Chí Minh</code>, <code class="bg-white px-1.5 py-0.5 rounded text-blue-900 font-black">Hà Tĩnh</code>, <code class="bg-white px-1.5 py-0.5 rounded text-blue-900 font-black">Hà Nội</code>, <code class="bg-white px-1.5 py-0.5 rounded text-blue-900 font-black">Đà Nẵng</code>...
              </li>
              <li><span class="font-semibold text-slate-900">• Cột 6 (Giai đoạn):</span> Trích từ <code class="bg-white px-1 rounded">Giai đoạn: ...</code> (Điều tra, Truy tố, Sơ thẩm...).</li>
              <li><span class="font-semibold text-slate-900">• Cột 7 (Mã bị can):</span> Dòng đầu tiên của cột C (giữ nguyên số 0 đầu bằng kiểu Text).</li>
              <li><span class="font-semibold text-slate-900">• Cột 8 (Tên bị can):</span> Họ tên đầy đủ của bị can.</li>
              <li><span class="font-semibold text-slate-900">• Cột 9 (Ngày sinh):</span> Tách từ tiền tố <code class="bg-white px-1 rounded">Ngày sinh:</code>.</li>
              <li><span class="font-semibold text-slate-900">• Cột 10 (Số CCCD):</span> Tách từ tiền tố <code class="bg-white px-1 rounded">CCCD:</code> (giữ nguyên 12 số định dạng Text).</li>
              <li><span class="font-semibold text-slate-900">• Cột 11 &amp; 12 (Điều luật &amp; Trạng thái hồ sơ):</span> Gom từ cột D và E (Đình nã, Truy nã, Tạm đình chỉ...).</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- TAB 4: MÃ NGUỒN PYTHON DESKTOP (.PY / .EXE OFFLINE)                       -->
    <!-- ========================================================================= -->
    <section id="viewDesktop" class="hidden space-y-4">
      <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-0.5 rounded-full bg-blue-100 text-blue-900 font-black text-xs">VKSND TP. Hồ Chí Minh</span>
              <h2 class="text-base font-bold text-slate-900">Mã nguồn Python Desktop Tkinter + OpenPyXL (Chủ đề VKSND TP.HCM)</h2>
            </div>
            <p class="text-xs text-slate-500 mt-0.5">
              Hệ thống tổng hợp và xử lý dữ liệu NTQLAHS với giao diện sinh động và bảng Pivot Table xuất Excel 2 Sheet.
            </p>
          </div>
          <div class="flex items-center gap-2">
            <button id="btnCopyPythonCode" type="button" class="px-3.5 py-2 rounded-xl text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-800 transition">
              Copy mã nguồn Python
            </button>
            <button id="btnDownloadPythonFile" type="button" class="px-4 py-2 rounded-xl text-xs font-black bg-[#0A2540] hover:bg-[#153E75] text-white transition shadow-sm">
              Tải file Phan_Mem_Chuan_Hoa_QLAHS_Desktop.py
            </button>
          </div>
        </div>

        <div class="p-3.5 rounded-xl bg-amber-50 border border-amber-300 text-xs text-amber-950 font-medium">
          <b>Lệnh đóng gói thành file .exe chạy độc lập cho máy tính Viện kiểm sát nhân dân:</b>
          <code class="block mt-1 bg-white px-3 py-2 rounded-lg border border-amber-300 font-mono text-[11px] text-slate-900 font-bold">
            pyinstaller --noconsole --onefile --name "NTQLAHS_VKSND_TPHCM" Phan_Mem_Chuan_Hoa_QLAHS_Desktop.py
          </code>
        </div>

        <pre id="pythonCodeBlock" class="bg-slate-900 text-slate-100 p-4 rounded-xl text-[11px] font-mono overflow-x-auto max-h-96 leading-relaxed"></pre>
      </div>
    </section>

  </main>

  <footer class="bg-slate-900 text-slate-400 py-3.5 border-t border-slate-800 text-center text-xs">
    <div class="max-w-7xl mx-auto px-4 flex flex-wrap items-center justify-between gap-2">
      <span class="font-bold text-slate-300">VIỆN KIỂM SÁT NHÂN DÂN THÀNH PHỐ HỒ CHÍ MINH &bull; HỆ THỐNG TỔNG HỢP VÀ XỬ LÝ DỮ LIỆU NTQLAHS</span>
      <span class="text-amber-400 font-bold">Bảo mật thông tin: Xử lý 100% Offline trên máy nội bộ cơ quan</span>
    </div>
  </footer>

  <script>
    // =========================================================================
    // 1. DANH MỤC 63 TỈNH / THÀNH PHỐ VÀ CƠ QUAN TRUNG ƯƠNG
    // =========================================================================
    const PROVINCE_MAP = [
      // 5 Thành phố trực thuộc Trung ương
      { name: "TP. Hồ Chí Minh", patterns: ["hồ chí minh", "ho chi minh", "tphcm", "tp.hcm", "tp hcm", "sài gòn", "thủ đức", "quận 1", "quận 3", "quận 4", "quận 5", "quận 6", "quận 7", "quận 8", "quận 10", "quận 11", "quận 12", "bình thạnh", "gò vấp", "tân bình", "tân phú", "phú nhuận", "bình tân", "củ chi", "hóc môn", "bình chánh", "nhà bè", "cần giờ"] },
      { name: "Hà Nội", patterns: ["hà nội", "ha noi", "thủ đô hà nội", "hn", "ba đình", "hoàn kiếm", "đống đa", "hai bà trưng", "cầu giấy", "thanh xuân", "hoàng mai", "long biên", "nam từ liêm", "bắc từ liêm", "tây hồ", "hà đông", "sơn tây", "ba vì", "đông anh", "gia lâm", "sóc sơn", "thanh trì"] },
      { name: "Hải Phòng", patterns: ["hải phòng", "hai phong", "hp", "ngô quyền", "hồng bàng", "lê chân", "hải an", "kiến an", "đồ sơn", "thủy nguyên", "cát hải"] },
      { name: "Đà Nẵng", patterns: ["đà nẵng", "da nang", "hải châu", "thanh khê", "sơn trà", "ngũ hành sơn", "liên chiểu", "cẩm lệ", "hòa vang"] },
      { name: "Cần Thơ", patterns: ["cần thơ", "can tho", "ninh kiều", "bình thủy", "cái răng", "ô môn", "thốt nốt"] },

      // Miền Bắc
      { name: "Bắc Giang", patterns: ["bắc giang", "bac giang", "việt yên", "hiệp hòa", "lục ngạn"] },
