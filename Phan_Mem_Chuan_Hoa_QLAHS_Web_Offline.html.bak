      { name: "VKSND tối cao", patterns: ["vksnd tối cao", "vksndtc", "viện kiểm sát nhân dân tối cao", "cơ quan điều tra vksnd"] }
    ];

    // Tiền biên dịch biểu thức chính quy 63 Tỉnh/Thành tăng tốc độ x100 lần
    const COMPILED_PROVINCE_MAP = PROVINCE_MAP.map(item => {
      const parts = item.patterns.map(p => "(?:\\b|[\\s,.\\-_/])" + p.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + "(?:\\b|[\\s,.\\-_/]|$)");
      return {
        name: item.name,
        regex: new RegExp(parts.join("|"), "i")
      };
    });

    function detectProvince(cqdtText, fallbackText = "") {
      if (!cqdtText && !fallbackText) return "Chưa xác định";
      const target = (String(cqdtText || "") + " " + String(fallbackText || "")).toLowerCase();

      for (let i = 0; i < COMPILED_PROVINCE_MAP.length; i++) {
        if (COMPILED_PROVINCE_MAP[i].regex.test(target)) {
          return COMPILED_PROVINCE_MAP[i].name;
        }
      }

      const m = target.match(/(?:tỉnh|thành\s*phố|tp\.?|tx\.?)\s+([a-zà-ỹ\s]+?)(?:,|-|\.|$)/i);
      if (m && m[1]) {
        let cand = m[1].trim();
        if (cand.length >= 2 && !["công an", "cảnh sát", "điều tra", "hồ sơ"].includes(cand.toLowerCase())) {
          return cand.split(/\s+/).map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");
        }
      }

      return "Khác / Chưa rõ";
    }

    // =========================================================================
    // QUẢN LÝ LOADING MODAL & TIẾN TRÌNH XỬ LÝ DỮ LIỆU NẶNG
    // =========================================================================
    function showLoading(title = "Đang xử lý dữ liệu hồ sơ QLAHS...", detail = "Hệ thống đang chuẩn hóa và tính toán...") {
      const modal = document.getElementById("appLoadingModal");
      if (!modal) return;
      const titleEl = document.getElementById("appLoadingTitle");
      const detailEl = document.getElementById("appLoadingDetail");
      if (titleEl) titleEl.textContent = title;
      if (detailEl) detailEl.textContent = detail;
      modal.classList.remove("hidden");
    }

    function updateLoadingDetail(detail) {
      const detailEl = document.getElementById("appLoadingDetail");
      if (detailEl) detailEl.textContent = detail;
    }

    function hideLoading() {
      const modal = document.getElementById("appLoadingModal");
      if (modal) modal.classList.add("hidden");
    }

    async function runWithLoading(title, detail, taskFn) {
      showLoading(title, detail);
      // Nhường luồng cho trình duyệt render popup loading trước khi chạy tính toán nặng
      await new Promise(r => setTimeout(r, 60));
      try {
        const res = await taskFn();
        return res;
      } catch (err) {
        showToast("Lỗi xử lý: " + err.message, true);
        throw err;
      } finally {
        hideLoading();
      }
    }

    // Dữ liệu mẫu ban đầu
    const INITIAL_RAW_ROWS = [
      ["STT", "Thông tin hồ sơ", "Họ tên", "Tội danh", "Trạng thái hồ sơ"],
      ["", "Giai đoạn: Điều tra", "010214.082002.104.00425", "", ""],
      ["", "VA 010214.072002.104.01616", "Trần Thanh Hoàng", "", ""],
      ["1", "Trần Thanh Hoàng cố ý gây thương tích cho Nguyễn Văn Chìm", "Ngày sinh: 31/12/1967", "Điều 104 - Tội cố ý gây thương tích hoặc gây tổn hại cho sức khoẻ của người khác", "Đình nã"],
      ["", "Công an Thành phố Hồ Chí Minh", "", "", ""],
      ["", "Giai đoạn: Sơ thẩm", "VA_E01.59.010_2606_0090_001", "", ""],
      ["", "VA_E01.59.010_2606_0090", "Nguyễn Ngọc Lài", "", ""],
      ["2", "Nguyễn Ngọc Lài. Đ138", "Ngày sinh: 20/12/1985", "Điều 138 - Tội trộm cắp tài sản", "Đình nã"],
      ["", "Công an tỉnh Hà Tĩnh", "CCCD: 000000000003", "", ""]
    ];

    const CQDT_PREFIXES = [
      "công an", "cơ quan", "cqcsđt", "cqđt", "cục điều tra",
      "viện kiểm sát", "bộ tư lệnh", "chi cục", "đồn biên phòng", "hải quan", "kiểm lâm"
    ];

    let appState = {
      records: [],
      searchQuery: "",
      provinceFilter: "ALL",
      stageFilter: "ALL",
      statusFilter: "ALL",
      shortLaw: false,
      pivotRowField: "tinhThanh",
      pivotColField: "giaiDoan",
      pivotValueField: "defendants",
      pivotFullReport: false
    };

    function showToast(message, isError = false) {
      const box = document.getElementById("toastBox");
      const icon = document.getElementById("toastIcon");
      const txt = document.getElementById("toastText");
      txt.textContent = message;
      icon.className = "w-3.5 h-3.5 rounded-full shrink-0 " + (isError ? "bg-rose-500" : "bg-emerald-400");
      box.classList.remove("hidden");
      clearTimeout(window._toastTimer);
      window._toastTimer = setTimeout(() => {
        box.classList.add("hidden");
      }, 3600);
    }

    function splitCleanLines(arr) {
      const out = [];
      for (const item of arr) {
        if (item === null || item === undefined) continue;
        let raw = String(item).replace(/\r\n/g, "\n").replace(/\r/g, "\n");
        if (raw.startsWith('="') && raw.endsWith('"')) {
          raw = raw.slice(2, -1);
        }
        for (const sub of raw.split("\n")) {
          const s = sub.trim();
          if (s) out.push(s);
        }
      }
      return out;
    }

    function parseQLAHSRows(rawRows) {
      const blocks = [];
      let currentBlock = null;

      for (const row of rawRows) {
        if (!Array.isArray(row)) continue;
        const texts = [0, 1, 2, 3, 4].map(i => {
          let v = row[i];
          if (v === null || v === undefined) return "";
          let s = String(v).trim();
          if (s.startsWith('="') && s.endsWith('"')) s = s.slice(2, -1).trim();
          return s;
        });

        if (texts.every(t => t === "")) continue;

        const c0Low = texts[0].toLowerCase();
        const c1Low = texts[1].toLowerCase();
        const c2Low = texts[2].toLowerCase();
        if (c0Low === "stt" || c1Low.includes("thông tin hồ sơ") || (c1Low === "" && c2Low === "họ tên")) {
          continue;
        }

        const bLines = texts[1].replace(/\r\n/g, "\n").split("\n").map(x => x.trim()).filter(Boolean);
        const startsNewBlock = bLines.some(ln => /^giai\s*đoạn\s*:/i.test(ln));

        if (startsNewBlock) {
          if (currentBlock) blocks.push(currentBlock);
          currentBlock = { A: [], B: [], C: [], D: [], E: [] };
        }
        if (!currentBlock) {
          currentBlock = { A: [], B: [], C: [], D: [], E: [] };
        }

        if (texts[0]) currentBlock.A.push(texts[0]);
        if (texts[1]) currentBlock.B.push(texts[1]);
        if (texts[2]) currentBlock.C.push(texts[2]);
        if (texts[3]) currentBlock.D.push(texts[3]);
        if (texts[4]) currentBlock.E.push(texts[4]);
      }

      if (currentBlock && (currentBlock.A.length || currentBlock.B.length || currentBlock.C.length)) {
        blocks.push(currentBlock);
      }

      const results = [];
      blocks.forEach((blk, idx) => {
        const aLines = splitCleanLines(blk.A);
        const bLines = splitCleanLines(blk.B);
        const cLines = splitCleanLines(blk.C);
        const dLines = splitCleanLines(blk.D);
        const eLines = splitCleanLines(blk.E);

        // 1. STT
        let sttVal = idx + 1;
        for (const a of aLines) {
          if (/^\d+$/.test(a)) {
            sttVal = parseInt(a, 10);
            break;
          }
        }

        // 2. Cột B: Giai đoạn, Mã vụ án, Tên vụ án, Cơ quan CSĐT
        let giaiDoan = "";
        const bRem = [];
        for (const ln of bLines) {
          const mGd = ln.match(/^giai\s*đoạn\s*:\s*(.*)$/i);
          if (mGd && !giaiDoan) {
            giaiDoan = mGd[1].trim();
          } else {
            bRem.push(ln);
          }
        }

        let maVuAn = "";
        let tenVuAn = "";
        let cqdt = "";
        if (bRem.length >= 3) {
          maVuAn = bRem[0];
          cqdt = bRem[bRem.length - 1];
          tenVuAn = bRem.slice(1, bRem.length - 1).join(" - ");
        } else if (bRem.length === 2) {
          maVuAn = bRem[0];
          const secondLow = bRem[1].toLowerCase();
          if (CQDT_PREFIXES.some(p => secondLow.startsWith(p))) {
            cqdt = bRem[1];
          } else {
            tenVuAn = bRem[1];
          }
        } else if (bRem.length === 1) {
          maVuAn = bRem[0];
        }

        // Nhận dạng Tỉnh/Thành từ CQĐT
        const tinhThanh = detectProvince(cqdt, tenVuAn);

        // 3. Cột C: Mã bị can, Tên bị can, Ngày sinh, Số CCCD
        const subDefendants = [];
        let curDef = { rem: [], ngaySinh: "", soCccd: "" };

        for (const ln of cLines) {
          const mNs = ln.match(/^(?:ngày\s*sinh|năm\s*sinh|ns)\s*:\s*(.*)$/i);
          const mCccd = ln.match(/^(?:cccd|số\s*cccd|cmnd|số\s*cmnd|đdcn|căn\s*cước[^:]*)\s*:\s*(.*)$/i);
          if (mNs) {
            curDef.ngaySinh = mNs[1].trim();
          } else if (mCccd) {
            curDef.soCccd = mCccd[1].trim();
          } else {
            if (curDef.rem.length >= 2 && (curDef.ngaySinh || curDef.soCccd)) {
              subDefendants.push(curDef);
              curDef = { rem: [ln], ngaySinh: "", soCccd: "" };
            } else {
              curDef.rem.push(ln);
            }
          }
        }
        if (curDef.rem.length > 0 || curDef.ngaySinh || curDef.soCccd) {
          subDefendants.push(curDef);
        }
        if (subDefendants.length === 0) {
          subDefendants.push({ rem: [], ngaySinh: "", soCccd: "" });
        }

        const dieuLuatFull = Array.from(new Set(dLines)).join("; ");
        const trangThai = Array.from(new Set(eLines)).join("; ");

        subDefendants.forEach((defItem) => {
          let maBiCan = "";
          let tenBiCan = "";
          if (defItem.rem.length >= 2) {
            maBiCan = defItem.rem[0];
            tenBiCan = defItem.rem.slice(1).join(" ");
          } else if (defItem.rem.length === 1) {
            if (/\d/.test(defItem.rem[0])) {
              maBiCan = defItem.rem[0];
            } else {
              tenBiCan = defItem.rem[0];
            }
          }

          results.push({
            id: "rec_" + Date.now() + "_" + Math.random().toString(36).slice(2, 8),
            stt: sttVal,
            maVuAn: maVuAn,
            tenVuAn: tenVuAn,
            cqdt: cqdt,
            tinhThanh: tinhThanh,
            giaiDoan: giaiDoan,
            maBiCan: maBiCan,
            tenBiCan: tenBiCan,
            ngaySinh: defItem.ngaySinh,
            soCccd: defItem.soCccd,
            dieuLuat: dieuLuatFull,
            trangThai: trangThai
          });
        });
      });

      results.forEach((r, i) => {
        if (!r.stt) r.stt = i + 1;
      });
      return results;
    }

    function formatLawDisplay(lawStr) {
      if (!appState.shortLaw || !lawStr) return lawStr;
      const m = lawStr.match(/(Điều\s+\d+[a-zA-Z0-9]*)/i);
      return m ? m[1] : lawStr;
    }

    // Đọc & Ghi XLSX Offline Multi-Sheet
    async function inflateRawBuffer(compressedBytes) {
      if (typeof DecompressionStream === "undefined") {
        throw new Error("Trình duyệt không hỗ trợ DecompressionStream.");
      }
      const ds = new DecompressionStream("deflate-raw");
      const writer = ds.writable.getWriter();
      writer.write(compressedBytes);
      writer.close();
      const reader = ds.readable.getReader();
      const chunks = [];
      let total = 0;
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        chunks.push(value);
        total += value.byteLength;
      }
      const out = new Uint8Array(total);
      let offset = 0;
      for (const c of chunks) {
        out.set(c, offset);
        offset += c.byteLength;
      }
      return out;
    }

    async function unzipXlsxEntries(arrayBuffer) {
      const view = new DataView(arrayBuffer);
      const bytes = new Uint8Array(arrayBuffer);
      const files = {};

      let eocdPos = -1;
      for (let i = bytes.length - 22; i >= Math.max(0, bytes.length - 65557); i--) {
        if (view.getUint32(i, true) === 0x06054b50) {
          eocdPos = i;
          break;
        }
      }
      if (eocdPos === -1) throw new Error("File không đúng định dạng ZIP/XLSX.");

      const totalEntries = view.getUint16(eocdPos + 10, true);
      let cdOffset = view.getUint32(eocdPos + 16, true);
      const decoder = new TextDecoder("utf-8");

      for (let idx = 0; idx < totalEntries; idx++) {
        if (view.getUint32(cdOffset, true) !== 0x02014b50) break;
        const method = view.getUint16(cdOffset + 10, true);
        const compSize = view.getUint32(cdOffset + 20, true);
        const nameLen = view.getUint16(cdOffset + 28, true);
        const extraLen = view.getUint16(cdOffset + 30, true);
        const commentLen = view.getUint16(cdOffset + 32, true);
        const localHeaderOffset = view.getUint32(cdOffset + 42, true);

        const name = decoder.decode(bytes.subarray(cdOffset + 46, cdOffset + 46 + nameLen));
        cdOffset += 46 + nameLen + extraLen + commentLen;

        const locNameLen = view.getUint16(localHeaderOffset + 26, true);
        const locExtraLen = view.getUint16(localHeaderOffset + 28, true);
        const dataOffset = localHeaderOffset + 30 + locNameLen + locExtraLen;
        const compData = bytes.subarray(dataOffset, dataOffset + compSize);

        if (method === 0) {
          files[name] = compData;
        } else if (method === 8) {
          try {
            files[name] = await inflateRawBuffer(compData);
          } catch (e) {
            // bỏ qua
          }
        }
      }
      return files;
    }

    async function readXlsxToRowsOffline(arrayBuffer) {
      const files = await unzipXlsxEntries(arrayBuffer);
      const decoder = new TextDecoder("utf-8");

      let sharedStrings = [];
      const ssKey = Object.keys(files).find(k => k.toLowerCase().endsWith("sharedstrings.xml"));
      if (ssKey && files[ssKey]) {
        const ssXml = decoder.decode(files[ssKey]);
        const parser = new DOMParser();
        const doc = parser.parseFromString(ssXml, "application/xml");
        const siList = doc.getElementsByTagName("si");
        for (let i = 0; i < siList.length; i++) {
          const tTags = siList[i].getElementsByTagName("t");
          let strVal = "";
          for (let j = 0; j < tTags.length; j++) strVal += tTags[j].textContent;
          sharedStrings.push(strVal);
        }
      }

      const sheetKey = Object.keys(files).find(k => k.toLowerCase().includes("sheet1.xml")) ||
                       Object.keys(files).find(k => k.toLowerCase().includes("sheet"));
      if (!sheetKey || !files[sheetKey]) {
        throw new Error("Không tìm thấy worksheet trong file Excel.");
      }

      const sheetXml = decoder.decode(files[sheetKey]);
      const parser = new DOMParser();
      const doc = parser.parseFromString(sheetXml, "application/xml");

      function colLetterToIndex(colStr) {
        let n = 0;
        for (let i = 0; i < colStr.length; i++) {
          n = n * 26 + (colStr.charCodeAt(i) - 64);
        }
        return n - 1;
      }

      const rowNodes = doc.getElementsByTagName("row");
      const grid = [];

      for (let r = 0; r < rowNodes.length; r++) {
        const rowNode = rowNodes[r];
        const rIndexAttr = parseInt(rowNode.getAttribute("r") || (r + 1), 10) - 1;
        while (grid.length <= rIndexAttr) grid.push([]);
        const rowCells = grid[rIndexAttr];

        const cNodes = rowNode.getElementsByTagName("c");
        for (let c = 0; c < cNodes.length; c++) {
          const cNode = cNodes[c];
          const ref = cNode.getAttribute("r") || "";
          const tType = cNode.getAttribute("t") || "";
          const m = ref.match(/^([A-Z]+)(\d+)$/);
          if (!m) continue;
          const colIdx = colLetterToIndex(m[1]);

          let cellVal = "";
          const vTag = cNode.getElementsByTagName("v")[0];
          const isTag = cNode.getElementsByTagName("is")[0];

          if (tType === "s" && vTag) {
            const idxVal = parseInt(vTag.textContent, 10);
            cellVal = sharedStrings[idxVal] || "";
          } else if (tType === "inlineStr" && isTag) {
            const tTag = isTag.getElementsByTagName("t")[0];
            cellVal = tTag ? tTag.textContent : "";
          } else if (vTag) {
            cellVal = vTag.textContent;
          }
          while (rowCells.length <= colIdx) rowCells.push("");
          rowCells[colIdx] = cellVal;
        }
      }
      return grid;
    }

    const CRC_TABLE = new Uint32Array(256);
    for (let i = 0; i < 256; i++) {
      let c = i;
      for (let k = 0; k < 8; k++) c = (c & 1) ? (0xedb88320 ^ (c >>> 1)) : (c >>> 1);
      CRC_TABLE[i] = c;
    }
    function calcCrc32(bytes) {
      let crc = 0xffffffff;
      for (let i = 0; i < bytes.length; i++) {
        crc = (crc >>> 8) ^ CRC_TABLE[(crc ^ bytes[i]) & 0xff];
      }
      return (crc ^ 0xffffffff) >>> 0;
    }

    function buildStoreZip(fileEntries) {
      const encoder = new TextEncoder();
      const localParts = [];
      const centralParts = [];
      let offset = 0;

      for (const entry of fileEntries) {
        const nameBytes = encoder.encode(entry.name);
        const dataBytes = typeof entry.content === "string" ? encoder.encode(entry.content) : entry.content;
        const size = dataBytes.length;
        const crc = calcCrc32(dataBytes);

        const localHeader = new Uint8Array(30 + nameBytes.length);
        const lv = new DataView(localHeader.buffer);
        lv.setUint32(0, 0x04034b50, true);
        lv.setUint16(4, 20, true);
        lv.setUint16(6, 0, true);
        lv.setUint16(8, 0, true);
        lv.setUint16(10, 0, true);
        lv.setUint16(12, 0x5421, true);
        lv.setUint32(14, crc, true);
        lv.setUint32(18, size, true);
        lv.setUint32(22, size, true);
        lv.setUint16(26, nameBytes.length, true);
        lv.setUint16(28, 0, true);
        localHeader.set(nameBytes, 30);
        localParts.push(localHeader, dataBytes);

        const centralHeader = new Uint8Array(46 + nameBytes.length);
        const cv = new DataView(centralHeader.buffer);
        cv.setUint32(0, 0x02014b50, true);
        cv.setUint16(4, 20, true);
        cv.setUint16(6, 20, true);
        cv.setUint16(8, 0, true);
        cv.setUint16(10, 0, true);
        cv.setUint16(12, 0x5421, true);
        cv.setUint32(16, crc, true);
        cv.setUint32(20, size, true);
        cv.setUint32(24, size, true);
        cv.setUint16(28, nameBytes.length, true);
        cv.setUint16(30, 0, true);
        cv.setUint16(32, 0, true);
        cv.setUint16(34, 0, true);
        cv.setUint16(36, 0, true);
        cv.setUint32(38, 0, true);
        cv.setUint32(42, offset, true);
        centralHeader.set(nameBytes, 46);
        centralParts.push(centralHeader);

        offset += localHeader.length + size;
      }

      const cdStart = offset;
      let cdSize = 0;
      for (const p of centralParts) cdSize += p.length;

      const eocd = new Uint8Array(22);
      const ev = new DataView(eocd.buffer);
      ev.setUint32(0, 0x06054b50, true);
      ev.setUint16(8, fileEntries.length, true);
      ev.setUint16(10, fileEntries.length, true);
      ev.setUint32(12, cdSize, true);
      ev.setUint32(16, cdStart, true);

      return new Blob([...localParts, ...centralParts, eocd], {
        type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
      });
    }

    function escapeXml(str) {
      return String(str ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&apos;");
    }

    function indexToColLetter(colIdx) {
      let n = colIdx + 1;
      let s = "";
      while (n > 0) {
        const m = (n - 1) % 26;
        s = String.fromCharCode(65 + m) + s;
        n = Math.floor((n - 1) / 26);
      }
      return s;
    }

    function generateSheetXml(gridRows, colWidths, isStandard12Cols = true) {
      let rowsXml = "";
      for (let rIdx = 0; rIdx < gridRows.length; rIdx++) {
        const row = gridRows[rIdx];
        const rNum = rIdx + 1;
        const rowHeight = rIdx === 0 ? 28 : 25;
        let cellsXml = "";

        for (let cIdx = 0; cIdx < row.length; cIdx++) {
          const val = row[cIdx] ?? "";
          const cellRef = indexToColLetter(cIdx) + rNum;

          let styleId = 3;
          if (rIdx === 0) {
            styleId = isStandard12Cols ? 1 : 5;
          } else if (isStandard12Cols && cIdx === 0) {
            styleId = 2;
          } else if (isStandard12Cols && (cIdx === 1 || cIdx === 4 || cIdx === 7)) {
            styleId = 4;
          }

          if (rIdx > 0 && isStandard12Cols && cIdx === 0 && /^\d+$/.test(String(val))) {
            cellsXml += `<c r="${cellRef}" s="${styleId}"><v>${parseInt(val, 10)}</v></c>`;
          } else {
            cellsXml += `<c r="${cellRef}" s="${styleId}" t="inlineStr"><is><t>${escapeXml(val)}</t></is></c>`;
          }
        }
        rowsXml += `<row r="${rNum}" ht="${rowHeight}" customHeight="1">${cellsXml}</row>`;
      }

      const colsXml = colWidths.map((w, idx) =>
        `<col min="${idx + 1}" max="${idx + 1}" width="${w}" customWidth="1"/>`
      ).join("");

      return `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">
  <sheetViews>
    <sheetView tabSelected="1" workbookViewId="0" showGridLines="1">
      <pane ySplit="1" topLeftCell="A2" activePane="bottomLeft" state="frozen"/>
    </sheetView>
  </sheetViews>
  <cols>${colsXml}</cols>
  <sheetData>${rowsXml}</sheetData>
</worksheet>`;
    }

    function generateMultiSheetXlsxBlob(sheets) {
      const stylesXml = `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<styleSheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">
  <numFmts count="1">
    <numFmt numFmtId="164" formatCode="@"/>
  </numFmts>
  <fonts count="4">
    <font><sz val="11"/><color rgb="FF000000"/><name val="Times New Roman"/></font>
    <font><b/><sz val="11"/><color rgb="FFFFFFFF"/><name val="Times New Roman"/></font>
    <font><b/><sz val="11"/><color rgb="FF000000"/><name val="Times New Roman"/></font>
    <font><b/><sz val="11"/><color rgb="FFFFFFFF"/><name val="Times New Roman"/></font>
  </fonts>
  <fills count="4">
    <fill><patternFill patternType="none"/></fill>
    <fill><patternFill patternType="gray125"/></fill>
    <fill><patternFill patternType="solid"><fgColor rgb="FF0A2540"/><bgColor indexed="64"/></patternFill></fill>
    <fill><patternFill patternType="solid"><fgColor rgb="FF991B1B"/><bgColor indexed="64"/></patternFill></fill>
  </fills>
  <borders count="2">
    <border><left/><right/><top/><bottom/><diagonal/></border>
    <border>
      <left style="thin"><color rgb="FFD1D5DB"/></left>
      <right style="thin"><color rgb="FFD1D5DB"/></right>
      <top style="thin"><color rgb="FFD1D5DB"/></top>
      <bottom style="thin"><color rgb="FFD1D5DB"/></bottom>
      <diagonal/>
    </border>
  </borders>
  <cellStyleXfs count="1"><xf numFmtId="0" fontId="0" fillId="0" borderId="0"/></cellStyleXfs>
  <cellXfs count="6">
    <xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0"/>
    <xf numFmtId="0" fontId="1" fillId="2" borderId="1" xfId="0" applyFont="1" applyFill="1" applyBorder="1" applyAlignment="1">
      <alignment horizontal="center" vertical="center" wrapText="1"/>
    </xf>
    <xf numFmtId="1" fontId="0" fillId="0" borderId="1" xfId="0" applyNumberFormat="1" applyFont="1" applyBorder="1" applyAlignment="1">
      <alignment horizontal="center" vertical="center"/>
    </xf>
    <xf numFmtId="164" fontId="0" fillId="0" borderId="1" xfId="0" applyNumberFormat="1" applyFont="1" applyBorder="1" applyAlignment="1">
      <alignment horizontal="left" vertical="center" wrapText="1"/>
    </xf>
    <xf numFmtId="164" fontId="2" fillId="0" borderId="1" xfId="0" applyNumberFormat="1" applyFont="1" applyBorder="1" applyAlignment="1">
      <alignment horizontal="left" vertical="center" wrapText="1"/>
    </xf>
    <xf numFmtId="0" fontId="1" fillId="3" borderId="1" xfId="0" applyFont="1" applyFill="1" applyBorder="1" applyAlignment="1">
      <alignment horizontal="center" vertical="center" wrapText="1"/>
    </xf>
  </cellXfs>
</styleSheet>`;

      const sheetEntriesXml = sheets.map((sh, idx) =>
        `<sheet name="${escapeXml(sh.name)}" sheetId="${idx + 1}" r:id="rId${idx + 1}"/>`
      ).join("");

      const workbookXml = `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"
          xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships">
  <sheets>${sheetEntriesXml}</sheets>
</workbook>`;

      const wbRelEntriesXml = sheets.map((sh, idx) =>
        `<Relationship Id="rId${idx + 1}" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet${idx + 1}.xml"/>`
      ).join("") + `<Relationship Id="rId${sheets.length + 1}" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles" Target="styles.xml"/>`;

      const wbRelsXml = `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">
  ${wbRelEntriesXml}
</Relationships>`;

      const rootRelsXml = `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">
  <Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/>
</Relationships>`;

      const overrideSheetsXml = sheets.map((sh, idx) =>
        `<Override PartName="/xl/worksheets/sheet${idx + 1}.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>`
      ).join("");

      const contentTypesXml = `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">
  <Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>
  <Default Extension="xml" ContentType="application/xml"/>
  <Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/>
  ${overrideSheetsXml}
  <Override PartName="/xl/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml"/>
</Types>`;

      const files = [
        { name: "[Content_Types].xml", content: contentTypesXml },
        { name: "_rels/.rels", content: rootRelsXml },
        { name: "xl/workbook.xml", content: workbookXml },
        { name: "xl/_rels/workbook.xml.rels", content: wbRelsXml },
        { name: "xl/styles.xml", content: stylesXml }
      ];

      sheets.forEach((sh, idx) => {
        const sheetXml = generateSheetXml(sh.grid, sh.widths, sh.isStandard !== false);
        files.push({ name: `xl/worksheets/sheet${idx + 1}.xml`, content: sheetXml });
      });

      return buildStoreZip(files);
    }

    function triggerDownloadBlob(blob, filename) {
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(url), 1500);
    }

    // Hiển thị & Lọc
    function getFilteredRecords() {
      const q = appState.searchQuery.trim().toLowerCase();
      return appState.records.filter(r => {
        if (appState.provinceFilter !== "ALL" && r.tinhThanh !== appState.provinceFilter) {
          return false;
        }
        if (appState.stageFilter !== "ALL" && r.giaiDoan.toLowerCase() !== appState.stageFilter.toLowerCase()) {
          return false;
        }
        if (appState.statusFilter !== "ALL" && !r.trangThai.toLowerCase().includes(appState.statusFilter.toLowerCase())) {
          return false;
        }
        if (q) {
          const hay = [
            r.maVuAn, r.tenVuAn, r.cqdt, r.tinhThanh, r.giaiDoan,
            r.maBiCan, r.tenBiCan, r.ngaySinh, r.soCccd, r.dieuLuat, r.trangThai
          ].join(" ").toLowerCase();
          if (!hay.includes(q)) return false;
        }
        return true;
      });
    }

    function updateProvinceDropdown() {
      const provSelect = document.getElementById("provinceFilter");
      const currentVal = appState.provinceFilter;
      const uniqueProvs = Array.from(new Set(appState.records.map(r => r.tinhThanh).filter(Boolean))).sort();

      provSelect.innerHTML = `<option value="ALL">🏛️ Tất cả Tỉnh/Thành (${uniqueProvs.length})</option>`;
      uniqueProvs.forEach(p => {
        const count = appState.records.filter(r => r.tinhThanh === p).length;
        const opt = document.createElement("option");
        opt.value = p;
        opt.textContent = `${p} (${count})`;
        if (p === currentVal) opt.selected = true;
        provSelect.appendChild(opt);
      });
    }

    function updateKPIs() {
      const recs = appState.records;
      document.getElementById("kpiTotal").textContent = String(recs.length);

      const uniqueCases = new Set(recs.map(r => r.maVuAn.trim()).filter(Boolean));
      document.getElementById("kpiCases").textContent = String(uniqueCases.size);

      const uniqueProvs = new Set(recs.map(r => r.tinhThanh.trim()).filter(Boolean));
      document.getElementById("kpiProvinces").textContent = String(uniqueProvs.size);

      const stageCounts = {};
      const statusCounts = {};
      for (const r of recs) {
        const gd = r.giaiDoan.trim() || "Chưa rõ";
        stageCounts[gd] = (stageCounts[gd] || 0) + 1;
        const tt = r.trangThai.trim() || "Khác";
        statusCounts[tt] = (statusCounts[tt] || 0) + 1;
      }

      const stageText = Object.entries(stageCounts).map(([k, v]) => `${k}: ${v}`).join(" | ") || "Chưa có dữ liệu";
      const statusText = Object.entries(statusCounts).map(([k, v]) => `${k}: ${v}`).join(" | ") || "Chưa có dữ liệu";

      document.getElementById("kpiStages").textContent = stageText;
      document.getElementById("kpiStatus").textContent = statusText;
    }

    function renderTable() {
      updateKPIs();
      updateProvinceDropdown();
      const tbody = document.getElementById("resultTableBody");
      const filtered = getFilteredRecords();
      tbody.innerHTML = "";

      if (filtered.length === 0) {
        const tr = document.createElement("tr");
        tr.innerHTML = `<td colspan="13" class="py-12 text-center text-slate-400 font-bold text-sm">Không tìm thấy bản ghi nào khớp với điều kiện lọc.</td>`;
        tbody.appendChild(tr);
      } else {
        filtered.forEach((rec, idx) => {
          const tr = document.createElement("tr");
          tr.className = idx % 2 === 1 ? "bg-slate-50/70 hover:bg-amber-50/50 transition-colors" : "bg-white hover:bg-amber-50/50 transition-colors";

          // Format badge cho từng cột sinh động
          const isTruyNa = rec.trangThai.toLowerCase().includes("truy nã");
          const isDinhNa = rec.trangThai.toLowerCase().includes("đình nã");
          const statusBadgeCls = isTruyNa
            ? "bg-rose-100 text-rose-900 border border-rose-300 font-black px-2.5 py-0.5 rounded-full shadow-sm"
            : (isDinhNa
                ? "bg-amber-100 text-amber-900 border border-amber-300 font-bold px-2.5 py-0.5 rounded-full shadow-sm"
                : "bg-slate-100 text-slate-800 border border-slate-300 font-medium px-2.5 py-0.5 rounded-full");

          const fields = [
            { key: "stt", html: `<span class="font-bold text-slate-500">${rec.stt}</span>`, cls: "text-center" },
            { key: "maVuAn", html: `<span class="font-mono font-bold text-indigo-950 bg-indigo-50/90 px-2 py-0.5 rounded-lg border border-indigo-200">${escapeXml(rec.maVuAn)}</span>`, cls: "" },
            { key: "tenVuAn", html: `<span class="font-bold text-slate-900">${escapeXml(rec.tenVuAn)}</span>`, cls: "" },
            { key: "cqdt", html: `<span class="text-slate-700 font-medium">${escapeXml(rec.cqdt)}</span>`, cls: "" },
            // Cột Tỉnh/Thành Badge nổi bật
            { key: "tinhThanh", html: `<span class="inline-flex items-center gap-1 font-black text-sky-950 bg-sky-100 border border-sky-300 px-2.5 py-0.5 rounded-full shadow-sm">🏛️ ${escapeXml(rec.tinhThanh)}</span>`, cls: "text-center" },
            // Cột Giai đoạn Badge
            { key: "giaiDoan", html: `<span class="inline-flex items-center font-bold text-emerald-950 bg-emerald-100 border border-emerald-300 px-2.5 py-0.5 rounded-full shadow-sm">${escapeXml(rec.giaiDoan)}</span>`, cls: "text-center" },
            { key: "maBiCan", html: `<span class="font-mono text-slate-800">${escapeXml(rec.maBiCan)}</span>`, cls: "" },
            { key: "tenBiCan", html: `<span class="font-black text-blue-950 bg-blue-50/50 px-1 rounded">${escapeXml(rec.tenBiCan)}</span>`, cls: "" },
            { key: "ngaySinh", html: `<span class="font-mono text-slate-700">${escapeXml(rec.ngaySinh)}</span>`, cls: "text-center" },
            { key: "soCccd", html: `<span class="font-mono font-semibold text-slate-800 bg-slate-100 px-1.5 py-0.5 rounded">${escapeXml(rec.soCccd)}</span>`, cls: "" },
            { key: "dieuLuat", html: `<span class="text-slate-800">${escapeXml(formatLawDisplay(rec.dieuLuat))}</span>`, cls: "" },
            { key: "trangThai", html: `<span class="${statusBadgeCls}">${escapeXml(rec.trangThai)}</span>`, cls: "text-center" }
          ];

          fields.forEach(f => {
            const td = document.createElement("td");
            td.className = `py-2.5 px-2.5 border-r border-slate-200 cell-edit ${f.cls}`;
            td.contentEditable = "true";
            td.innerHTML = f.html;
            td.addEventListener("blur", () => {
              const target = appState.records.find(item => item.id === rec.id);
              if (target) {
                target[f.key] = td.textContent.trim().replace(/^🏛️\s*/, "");
                updateKPIs();
                renderPivotTable();
              }
            });
            tr.appendChild(td);
          });

          // Nút xóa
          const tdDel = document.createElement("td");
          tdDel.className = "py-2 px-2 text-center";
          const btnDel = document.createElement("button");
          btnDel.type = "button";
          btnDel.className = "w-6 h-6 rounded-full bg-rose-100 text-rose-600 hover:bg-rose-600 hover:text-white font-bold flex items-center justify-center mx-auto transition";
          btnDel.textContent = "×";
          btnDel.title = "Xóa hồ sơ này";
          btnDel.addEventListener("click", () => {
            appState.records = appState.records.filter(item => item.id !== rec.id);
            renderTable();
            renderPivotTable();
            showToast("Đã xóa 1 hồ sơ bị can.");
          });
          tdDel.appendChild(btnDel);
          tr.appendChild(tdDel);

          tbody.appendChild(tr);
        });
      }

      document.getElementById("rowCountFooter").textContent =
        `Hiển thị ${filtered.length} / ${appState.records.length} bản ghi chuẩn hóa`;
    }

    // =========================================================================
    // 6. THUẬT TOÁN PIVOT TABLE MÀU SẮC SINH ĐỘNG
    // =========================================================================
    function getPivotData() {
      const recs = appState.records;
      const rowKey = appState.pivotRowField;
      const colKey = appState.pivotColField;
      const valMode = appState.pivotValueField;

      const rowValsSet = new Set();
      const colValsSet = new Set();

      recs.forEach(r => {
        rowValsSet.add(r[rowKey] || "(Chưa rõ)");
        if (colKey !== "NONE") {
          colValsSet.add(r[colKey] || "(Chưa rõ)");
        }
      });

      const stageOrder = ["Điều tra", "Truy tố", "Sơ thẩm", "Phúc thẩm", "Thi hành án"];
      const colVals = Array.from(colValsSet);
      if (colKey === "giaiDoan") {
        colVals.sort((a, b) => {
          const ia = stageOrder.indexOf(a);
          const ib = stageOrder.indexOf(b);
          if (ia !== -1 && ib !== -1) return ia - ib;
          if (ia !== -1) return -1;
          if (ib !== -1) return 1;
          return a.localeCompare(b, "vi");
        });
      } else {
        colVals.sort((a, b) => a.localeCompare(b, "vi"));
      }

      const matrix = {};
      const rowTotals = {};
      const colTotals = {};
      colVals.forEach(c => colTotals[c] = 0);
      let grandTotal = 0;

      recs.forEach(r => {
        const rVal = r[rowKey] || "(Chưa rõ)";
        const cVal = colKey !== "NONE" ? (r[colKey] || "(Chưa rõ)") : "__ALL__";
        const caseId = (r.maVuAn || "").trim();

        if (!matrix[rVal]) matrix[rVal] = {};
        if (!matrix[rVal][cVal]) {
          matrix[rVal][cVal] = { defCount: 0, cases: new Set() };
        }
        matrix[rVal][cVal].defCount += 1;
        if (caseId) matrix[rVal][cVal].cases.add(caseId);
      });

      const rowVals = Array.from(rowValsSet);

      rowVals.forEach(rVal => {
        let rTotal = 0;
        if (colKey === "NONE") {
          const cell = matrix[rVal]["__ALL__"] || { defCount: 0, cases: new Set() };
          rTotal = valMode === "cases" ? cell.cases.size : cell.defCount;
        } else {
          colVals.forEach(cVal => {
            const cell = matrix[rVal][cVal] || { defCount: 0, cases: new Set() };
            const count = valMode === "cases" ? cell.cases.size : cell.defCount;
            rTotal += count;
            colTotals[cVal] = (colTotals[cVal] || 0) + count;
          });
        }
        rowTotals[rVal] = rTotal;
        grandTotal += rTotal;
      });

      rowVals.sort((a, b) => (rowTotals[b] || 0) - (rowTotals[a] || 0));

      return {
        rowVals,
        colVals,
        matrix,
        rowTotals,
        colTotals,
        grandTotal,
        rowKey,
        colKey,
        valMode
      };
    }

    function renderPivotTable() {
      const table = document.getElementById("pivotMatrixTable");
      const chartContainer = document.getElementById("pivotChartBars");
      const insightsBox = document.getElementById("pivotInsights");

      if (appState.records.length === 0) {
        table.innerHTML = `<tr><td class="p-8 text-center text-slate-400 font-bold">Chưa có dữ liệu. Vui lòng nạp file Excel hoặc dán dữ liệu vào Bàn làm việc.</td></tr>`;
        chartContainer.innerHTML = `<div class="text-xs text-slate-400 text-center py-6">Chưa có dữ liệu biểu đồ.</div>`;
        insightsBox.innerHTML = `<div>Chưa có dữ liệu để phân tích.</div>`;
        document.getElementById("pivotGrandTotalSummary").textContent = "Tổng cộng: 0";
        return;
      }

      if (appState.pivotFullReport) {
        renderFullPivotReport(table, chartContainer, insightsBox);
        return;
      }

      const pData = getPivotData();
      const { rowVals, colVals, matrix, rowTotals, colTotals, grandTotal, valMode } = pData;

      const rowLabelMap = { tinhThanh: "🏛️ Tỉnh / Thành phố", cqdt: "Cơ quan CSĐT", giaiDoan: "Giai đoạn", trangThai: "Trạng thái hồ sơ" };
      const colLabelMap = { giaiDoan: "Giai đoạn tố tụng", trangThai: "Trạng thái hồ sơ", tinhThanh: "Tỉnh / Thành phố", NONE: "Tổng cộng" };
      document.getElementById("pivotTableTitle").innerHTML = `
        <span class="w-3 h-3 rounded-full bg-red-600"></span>
        Ma Trận Pivot Table: ${rowLabelMap[pData.rowKey]} × ${colLabelMap[pData.colKey]}
      `;
      document.getElementById("pivotMetaSubtitle").textContent = valMode === "cases" ? "Chỉ tiêu: Số vụ án" : "Chỉ tiêu: Số bị can (người)";
      document.getElementById("pivotGrandTotalSummary").textContent = `Tổng cộng: ${grandTotal} ${valMode === "cases" ? "vụ án" : "bị can"}`;

      let theadHtml = `<thead class="bg-[#991B1B] text-white font-bold"><tr>`;
      theadHtml += `<th class="py-3 px-3 border-r border-red-800 text-center w-12">STT</th>`;
      theadHtml += `<th class="py-3 px-3 border-r border-red-800 min-w-[180px]">${rowLabelMap[pData.rowKey]}</th>`;

      if (pData.colKey === "NONE") {
        theadHtml += `<th class="py-3 px-3 border-r border-red-800 text-center">Số lượng (${valMode === "cases" ? "Vụ" : "Người"})</th>`;
      } else {
        colVals.forEach(c => {
          theadHtml += `<th class="py-3 px-3 border-r border-red-800 text-center min-w-[105px]">${escapeXml(c)}</th>`;
        });
      }
      theadHtml += `<th class="py-3 px-3 border-r border-red-800 text-center bg-[#7F1D1D] font-black min-w-[100px]">Tổng cộng</th>`;
      theadHtml += `<th class="py-3 px-3 text-center bg-[#7F1D1D] font-black w-24">Tỷ lệ %</th>`;
      theadHtml += `</tr></thead>`;

      let tbodyHtml = `<tbody class="divide-y divide-slate-200">`;
      rowVals.forEach((rVal, idx) => {
        const rTotal = rowTotals[rVal] || 0;
        const pct = grandTotal > 0 ? (rTotal / grandTotal * 100).toFixed(1) : "0.0";
        const trCls = idx % 2 === 1 ? "bg-slate-50/70 hover:bg-amber-50/50 transition-colors" : "bg-white hover:bg-amber-50/50 transition-colors";

        tbodyHtml += `<tr class="${trCls}">`;
        tbodyHtml += `<td class="py-2.5 px-2.5 text-center font-bold text-slate-500 border-r border-slate-200">${idx + 1}</td>`;
        tbodyHtml += `<td class="py-2.5 px-3 font-black text-slate-900 border-r border-slate-200 flex items-center justify-between">
          <span class="flex items-center gap-1.5"><span class="text-blue-600 font-normal">📍</span> ${escapeXml(rVal)}</span>
          <span class="text-[10px] bg-blue-100 text-blue-900 px-2 py-0.5 rounded-full font-mono font-bold">${rTotal}</span>
        </td>`;

        if (pData.colKey === "NONE") {
          tbodyHtml += `<td class="py-2.5 px-3 text-center font-black text-blue-950 border-r border-slate-200">${rTotal}</td>`;
        } else {
          colVals.forEach(cVal => {
            const cell = matrix[rVal] && matrix[rVal][cVal] ? matrix[rVal][cVal] : { defCount: 0, cases: new Set() };
            const count = valMode === "cases" ? cell.cases.size : cell.defCount;
            let cellStyle = "text-center py-2.5 px-3 border-r border-slate-200 ";
            if (count > 0) {
              cellStyle += "bg-gradient-to-r from-blue-50 to-indigo-50 font-black text-blue-950 border-blue-200 shadow-inner";
            } else {
              cellStyle += "text-slate-300 font-medium";
            }
            tbodyHtml += `<td class="${cellStyle}">${count > 0 ? `<span class="bg-blue-600 text-white px-2 py-0.5 rounded-full text-[11px] font-bold shadow-sm">${count}</span>` : "-"}</td>`;
          });
        }

        tbodyHtml += `<td class="py-2.5 px-3 text-center font-black text-red-950 bg-red-50/80 border-r border-slate-200 text-sm">${rTotal}</td>`;
        tbodyHtml += `<td class="py-2.5 px-3 text-center font-bold text-slate-800 bg-slate-100/80">${pct}%</td>`;
        tbodyHtml += `</tr>`;
      });

      // Dòng TỔNG CỘNG CHUNG VÀNG RỰC
      tbodyHtml += `<tr class="bg-gradient-to-r from-amber-100 via-yellow-100 to-amber-100 font-black text-slate-900 border-t-2 border-amber-400">`;
      tbodyHtml += `<td class="py-3 px-2.5 text-center text-amber-900">∑</td>`;
      tbodyHtml += `<td class="py-3 px-3 uppercase tracking-wider text-red-950 font-black flex items-center gap-1.5">
        <span>⭐</span> TỔNG CỘNG CHUNG
      </td>`;

      if (pData.colKey === "NONE") {
        tbodyHtml += `<td class="py-3 px-3 text-center font-black text-red-900 text-sm">${grandTotal}</td>`;
      } else {
        colVals.forEach(cVal => {
          const colSum = colTotals[cVal] || 0;
          tbodyHtml += `<td class="py-3 px-3 text-center font-black text-blue-950 border-r border-amber-200">${colSum}</td>`;
        });
      }

      tbodyHtml += `<td class="py-3 px-3 text-center font-black text-red-950 bg-amber-200/80 text-base">${grandTotal}</td>`;
      tbodyHtml += `<td class="py-3 px-3 text-center font-black text-slate-900 bg-amber-200/80">100.0%</td>`;
      tbodyHtml += `</tr>`;
      tbodyHtml += `</tbody>`;

      table.innerHTML = theadHtml + tbodyHtml;

      renderDistributionBars(rowVals, rowTotals, grandTotal, chartContainer);
      renderInsights(pData, insightsBox);
    }

    function renderFullPivotReport(table, chartContainer, insightsBox) {
      document.getElementById("pivotTableTitle").innerHTML = `
        <span class="w-3 h-3 rounded-full bg-red-600"></span>
        BẢNG TỔNG HỢP TOÀN DIỆN VKSND TP. HỒ CHÍ MINH: ĐỊA BÀN &bull; VỤ ÁN &bull; BỊ CAN &bull; GIAI ĐOẠN &bull; TRẠNG THÁI
      `;
      document.getElementById("pivotMetaSubtitle").textContent = "Báo cáo thống kê chuyên sâu NTQLAHS";

      const recs = appState.records;
      const provMap = {};
      const stageList = ["Điều tra", "Truy tố", "Sơ thẩm", "Phúc thẩm"];
      const statusList = ["Đình nã", "Truy nã", "Tạm đình chỉ"];

      recs.forEach(r => {
        const prov = r.tinhThanh || "Khác / Chưa rõ";
        if (!provMap[prov]) {
          provMap[prov] = {
            cases: new Set(),
            defs: 0,
            stages: {},
            statuses: {}
          };
          stageList.forEach(s => provMap[prov].stages[s] = 0);
          statusList.forEach(st => provMap[prov].statuses[st] = 0);
        }
        provMap[prov].defs += 1;
        if (r.maVuAn) provMap[prov].cases.add(r.maVuAn.trim());
        const gd = r.giaiDoan.trim();
        if (provMap[prov].stages[gd] !== undefined) provMap[prov].stages[gd] += 1;
        const tt = r.trangThai.trim();
        statusList.forEach(st => {
          if (tt.toLowerCase().includes(st.toLowerCase())) {
            provMap[prov].statuses[st] += 1;
          }
        });
      });

      const provList = Object.keys(provMap).sort((a, b) => provMap[b].defs - provMap[a].defs);
      const totalDefs = recs.length;
      const totalCases = new Set(recs.map(r => r.maVuAn.trim()).filter(Boolean)).size;

      document.getElementById("pivotGrandTotalSummary").textContent = `Tổng: ${totalCases} vụ / ${totalDefs} bị can`;

      let html = `<thead class="bg-[#0A2540] text-white font-bold text-xs"><tr>
        <th class="py-2.5 px-2 border-r border-slate-600 text-center w-11" rowspan="2">STT</th>
        <th class="py-2.5 px-3 border-r border-slate-600 min-w-[170px]" rowspan="2">Tỉnh / Thành phố</th>
        <th class="py-2.5 px-2 border-r border-slate-600 text-center bg-blue-900" rowspan="2">Số vụ</th>
        <th class="py-2.5 px-2 border-r border-slate-600 text-center bg-red-900" rowspan="2">Số bị can</th>
        <th class="py-1.5 px-3 border-r border-slate-600 text-center bg-teal-900" colspan="4">Giai đoạn tố tụng</th>
        <th class="py-1.5 px-3 border-r border-slate-600 text-center bg-amber-900" colspan="3">Trạng thái hồ sơ</th>
        <th class="py-2.5 px-2 text-center bg-slate-800" rowspan="2">Tỷ lệ %</th>
      </tr>
      <tr class="bg-slate-800 text-amber-300 text-[11px]">
        <th class="py-1 px-2 border-r border-slate-600 text-center">Điều tra</th>
        <th class="py-1 px-2 border-r border-slate-600 text-center">Truy tố</th>
        <th class="py-1 px-2 border-r border-slate-600 text-center">Sơ thẩm</th>
        <th class="py-1 px-2 border-r border-slate-600 text-center">Phúc thẩm</th>
        <th class="py-1 px-2 border-r border-slate-600 text-center text-amber-300">Đình nã</th>
        <th class="py-1 px-2 border-r border-slate-600 text-center text-rose-300">Truy nã</th>
        <th class="py-1 px-2 border-r border-slate-600 text-center">Tạm ĐC</th>
      </tr>
      </thead><tbody class="divide-y divide-slate-200">`;

      provList.forEach((prov, idx) => {
        const item = provMap[prov];
        const pct = totalDefs > 0 ? (item.defs / totalDefs * 100).toFixed(1) : "0.0";
        html += `<tr class="${idx % 2 === 1 ? 'bg-slate-50/80' : 'bg-white'} hover:bg-amber-50/40">
          <td class="py-2.5 px-2 text-center text-slate-500 font-bold border-r border-slate-200">${idx + 1}</td>
          <td class="py-2.5 px-3 font-black text-slate-900 border-r border-slate-200">🏛️ ${escapeXml(prov)}</td>
          <td class="py-2.5 px-2 text-center font-bold text-blue-900 bg-blue-50/50 border-r border-slate-200">${item.cases.size}</td>
          <td class="py-2.5 px-2 text-center font-black text-red-900 bg-red-50/50 border-r border-slate-200">${item.defs}</td>
          <td class="py-2.5 px-2 text-center border-r border-slate-200 font-semibold">${item.stages["Điều tra"] || "-"}</td>
          <td class="py-2.5 px-2 text-center border-r border-slate-200 font-semibold">${item.stages["Truy tố"] || "-"}</td>
          <td class="py-2.5 px-2 text-center border-r border-slate-200 font-semibold">${item.stages["Sơ thẩm"] || "-"}</td>
          <td class="py-2.5 px-2 text-center border-r border-slate-200 font-semibold">${item.stages["Phúc thẩm"] || "-"}</td>
          <td class="py-2.5 px-2 text-center border-r border-slate-200 font-bold text-amber-900 bg-amber-50/30">${item.statuses["Đình nã"] || "-"}</td>
          <td class="py-2.5 px-2 text-center border-r border-slate-200 font-bold text-rose-900 bg-rose-50/30">${item.statuses["Truy nã"] || "-"}</td>
          <td class="py-2.5 px-2 text-center border-r border-slate-200 font-medium text-slate-700">${item.statuses["Tạm đình chỉ"] || "-"}</td>
          <td class="py-2.5 px-2 text-center font-bold text-slate-800 bg-slate-100">${pct}%</td>
        </tr>`;
      });

      html += `<tr class="bg-gradient-to-r from-amber-100 to-yellow-100 font-black text-slate-900 border-t-2 border-amber-400">
        <td class="py-3 px-2 text-center text-amber-900">∑</td>
        <td class="py-3 px-3 uppercase tracking-wider text-red-950 font-black">TỔNG CỘNG CHUNG</td>
        <td class="py-3 px-2 text-center font-black text-blue-950">${totalCases}</td>
        <td class="py-3 px-2 text-center font-black text-red-950 text-sm">${totalDefs}</td>
        <td class="py-3 px-2 text-center">${recs.filter(r => r.giaiDoan.includes("Điều tra")).length}</td>
        <td class="py-3 px-2 text-center">${recs.filter(r => r.giaiDoan.includes("Truy tố")).length}</td>
        <td class="py-3 px-2 text-center">${recs.filter(r => r.giaiDoan.includes("Sơ thẩm")).length}</td>
        <td class="py-3 px-2 text-center">${recs.filter(r => r.giaiDoan.includes("Phúc thẩm")).length}</td>
        <td class="py-3 px-2 text-center text-amber-950">${recs.filter(r => r.trangThai.includes("Đình nã")).length}</td>
        <td class="py-3 px-2 text-center text-rose-950">${recs.filter(r => r.trangThai.includes("Truy nã")).length}</td>
        <td class="py-3 px-2 text-center">${recs.filter(r => r.trangThai.includes("Tạm đình chỉ")).length}</td>
        <td class="py-3 px-2 text-center text-slate-950">100.0%</td>
      </tr></tbody>`;

      table.innerHTML = html;

      const rowTotals = {};
      provList.forEach(p => rowTotals[p] = provMap[p].defs);
      renderDistributionBars(provList, rowTotals, totalDefs, chartContainer);

      insightsBox.innerHTML = `
        <div>&bull; Báo cáo VKSND TP.HCM: Hệ thống đang tổng hợp <b>${totalDefs}</b> bị can thuộc <b>${totalCases}</b> vụ án tại <b>${provList.length}</b> địa bàn.</div>
        <div>&bull; Địa bàn thụ lý trọng điểm: <b class="text-blue-900">${provList[0] || 'Chưa rõ'}</b> (${rowTotals[provList[0]] || 0} bị can, chiếm ${(rowTotals[provList[0]]/totalDefs*100).toFixed(1)}%).</div>
      `;
    }

    function renderDistributionBars(rowVals, rowTotals, grandTotal, container) {
      container.innerHTML = "";
      const colors = [
        "from-blue-600 to-indigo-600",
        "from-emerald-600 to-teal-600",
        "from-rose-600 to-red-600",
        "from-amber-500 to-orange-600",
        "from-purple-600 to-pink-600"
      ];

      rowVals.slice(0, 10).forEach((rVal, idx) => {
        const count = rowTotals[rVal] || 0;
        const pct = grandTotal > 0 ? (count / grandTotal * 100).toFixed(1) : 0;
        const colorGrad = colors[idx % colors.length];

        const rowDiv = document.createElement("div");
        rowDiv.className = "space-y-1 text-xs bg-slate-50 p-2 rounded-xl border border-slate-200/80";
        rowDiv.innerHTML = `
          <div class="flex items-center justify-between font-black">
            <span class="text-slate-900 truncate max-w-[170px]" title="${escapeXml(rVal)}">📍 ${escapeXml(rVal)}</span>
            <span class="text-blue-900 font-mono text-[11px] bg-white px-2 py-0.5 rounded-full border border-slate-200">${count} (${pct}%)</span>
          </div>
          <div class="w-full bg-slate-200 rounded-full h-2.5 overflow-hidden shadow-inner">
            <div class="bg-gradient-to-r ${colorGrad} h-2.5 rounded-full transition-all duration-500 shadow-sm" style="width: ${pct}%"></div>
          </div>
        `;
        container.appendChild(rowDiv);
      });
    }

    function renderInsights(pData, container) {
      const { rowVals, rowTotals, grandTotal, valMode } = pData;
      if (rowVals.length === 0) {
        container.innerHTML = "<div>Chưa có dữ liệu.</div>";
        return;
      }
      const topRow = rowVals[0];
      const topCount = rowTotals[topRow] || 0;
      const topPct = grandTotal > 0 ? (topCount / grandTotal * 100).toFixed(1) : 0;

      container.innerHTML = `
        <div>&bull; Địa bàn có số lượng thụ lý cao nhất: <b class="text-blue-900 font-black">${escapeXml(topRow)}</b> với <b>${topCount}</b> ${valMode === "cases" ? "vụ án" : "bị can"} (${topPct}% tổng số).</div>
        <div>&bull; Tổng số tỉnh/thành phố phát sinh án: <b class="text-slate-900 font-black">${rowVals.length}</b> địa phương.</div>
        <div>&bull; Phục vụ công tác chỉ đạo điều hành của Viện trưởng VKSND TP. Hồ Chí Minh.</div>
      `;
    }

    // =========================================================================
    // 7. XUẤT EXCEL & COPY CLIPBOARD
    // =========================================================================
    async function exportPivotToExcel() {
      const pData = getPivotData();
      const { rowVals, colVals, matrix, rowTotals, colTotals, grandTotal, valMode } = pData;
      if (rowVals.length === 0) {
        showToast("Không có dữ liệu để xuất bảng Pivot!", true);
        return;
      }

      await runWithLoading(
        "Đang xuất file Excel Pivot Table",
        "Đang tính toán các chỉ số và định dạng bảng Excel...",
        async () => {
          const headers = ["STT", "Tỉnh / Thành phố", ...colVals, "Tổng cộng", "Tỷ lệ %"];
          const grid = [headers];

          rowVals.forEach((rVal, idx) => {
            const rTotal = rowTotals[rVal] || 0;
            const pct = grandTotal > 0 ? (rTotal / grandTotal * 100).toFixed(1) + "%" : "0%";
            const row = [String(idx + 1), rVal];
            colVals.forEach(cVal => {
              const cell = matrix[rVal] && matrix[rVal][cVal] ? matrix[rVal][cVal] : { defCount: 0, cases: new Set() };
              const count = valMode === "cases" ? cell.cases.size : cell.defCount;
              row.push(String(count));
            });
            row.push(String(rTotal));
            row.push(pct);
            grid.push(row);
          });

          const totalRow = ["", "TỔNG CỘNG CHUNG"];
          colVals.forEach(cVal => {
            totalRow.push(String(colTotals[cVal] || 0));
          });
          totalRow.push(String(grandTotal));
          totalRow.push("100.0%");
          grid.push(totalRow);

          const widths = [8, 26, ...colVals.map(() => 16), 16, 14];
          const blob = generateMultiSheetXlsxBlob([
            { name: "Tong_Hop_Pivot", grid: grid, widths: widths, isStandard: false }
          ]);
          triggerDownloadBlob(blob, "Bao_Cao_Pivot_Table_QLAHS.xlsx");
          showToast("Đã xuất Bảng Pivot Table sang file Excel!");
        }
      );
    }
      triggerDownloadBlob(blob, "Bao_Cao_Pivot_Table_NTQLAHS_TPHCM.xlsx");
      showToast("Đã xuất Bảng Pivot Table sang file Excel!");
    }

    function copyPivotTableToClipboard() {
      const pData = getPivotData();
      const { rowVals, colVals, matrix, rowTotals, colTotals, grandTotal, valMode } = pData;
      if (rowVals.length === 0) {
        showToast("Chưa có dữ liệu để copy!", true);
        return;
      }

      const lines = [];
      const headers = ["STT", "Tỉnh / Thành phố", ...colVals, "Tổng cộng", "Tỷ lệ %"];
      lines.push(headers.join("\t"));

      rowVals.forEach((rVal, idx) => {
        const rTotal = rowTotals[rVal] || 0;
        const pct = grandTotal > 0 ? (rTotal / grandTotal * 100).toFixed(1) + "%" : "0%";
        const row = [idx + 1, rVal];
        colVals.forEach(cVal => {
          const cell = matrix[rVal] && matrix[rVal][cVal] ? matrix[rVal][cVal] : { defCount: 0, cases: new Set() };
          const count = valMode === "cases" ? cell.cases.size : cell.defCount;
          row.push(count);
        });
        row.push(rTotal);
        row.push(pct);
        lines.push(row.join("\t"));
      });

      const totalRow = ["", "TỔNG CỘNG CHUNG", ...colVals.map(c => colTotals[c] || 0), grandTotal, "100.0%"];
      lines.push(totalRow.join("\t"));

      const tsv = lines.join("\r\n");
      const ta = document.createElement("textarea");
      ta.value = tsv;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand("copy");
      document.body.removeChild(ta);
      showToast("Đã copy Bảng Pivot Table vào Clipboard (có thể dán vào Word/Excel)!");
    }

    async function exportStandard12ColsAndPivotXlsx() {
      const filtered = getFilteredRecords();
      if (filtered.length === 0) {
        showToast("Không có dữ liệu để xuất ra file Excel!", true);
        return;
      }

      await runWithLoading(
        "Đang xuất file Excel chuẩn 12 cột & Pivot",
        `Đang định dạng ${filtered.length} bản ghi và tạo 2 Sheet...`,
        async () => {
          // Sheet 1: Danh sách 12 cột chuẩn
          const headers12 = [
            "STT", "Mã vụ án", "Tên vụ án", "Cơ quan cảnh sát điều tra", "Tỉnh/Thành", "Giai đoạn",
            "Mã bị can", "Tên bị can", "Ngày sinh", "Số CCCD", "Điều luật", "Trạng thái hồ sơ"
          ];
          const grid1 = [headers12];
          filtered.forEach((r, idx) => {
            grid1.push([
              String(r.stt || idx + 1),
              r.maVuAn || "",
              r.tenVuAn || "",
              r.cqdt || "",
              r.tinhThanh || "",
              r.giaiDoan || "",
              r.maBiCan || "",
              r.tenBiCan || "",
              r.ngaySinh || "",
              r.soCccd || "",
              formatLawDisplay(r.dieuLuat || ""),
              r.trangThai || ""
            ]);
          });
          const widths1 = [8, 24, 34, 28, 20, 14, 26, 22, 14, 16, 36, 18];

          // Sheet 2: Bảng Pivot Table Tổng hợp
          updateLoadingDetail("Đang tổng hợp dữ liệu Sheet Pivot Table...");
          await new Promise(r => setTimeout(r, 15));

          const pData = getPivotData();
          const headersPivot = ["STT", "Tỉnh / Thành phố", ...pData.colVals, "Tổng số bị can", "Tỷ lệ %"];
          const grid2 = [headersPivot];
          pData.rowVals.forEach((rVal, idx) => {
            const rTotal = pData.rowTotals[rVal] || 0;
            const pct = pData.grandTotal > 0 ? (rTotal / pData.grandTotal * 100).toFixed(1) + "%" : "0%";
            const row = [String(idx + 1), rVal];
            pData.colVals.forEach(cVal => {
              const cell = pData.matrix[rVal] && pData.matrix[rVal][cVal] ? pData.matrix[rVal][cVal] : { defCount: 0 };
              row.push(String(cell.defCount || 0));
            });
            row.push(String(rTotal));
            row.push(pct);
            grid2.push(row);
          });
          const totalRow = ["", "TỔNG CỘNG CHUNG", ...pData.colVals.map(c => String(pData.colTotals[c] || 0)), String(pData.grandTotal), "100.0%"];
          grid2.push(totalRow);
          const widths2 = [8, 26, ...pData.colVals.map(() => 16), 16, 14];

          updateLoadingDetail("Đang nén dữ liệu XLSX và tạo tập tin tải về...");
          await new Promise(r => setTimeout(r, 15));

          const blob = generateMultiSheetXlsxBlob([
            { name: "Danh_Sach_12_Cot_Chuan", grid: grid1, widths: widths1, isStandard: true },
            { name: "Tong_Hop_Pivot_Table", grid: grid2, widths: widths2, isStandard: false }
          ]);

          triggerDownloadBlob(blob, "Ket_Qua_Chuan_Hoa_NTQLAHS.xlsx");
          showToast(`Đã xuất ${filtered.length} dòng và Bảng Pivot Table sang file Ket_Qua_Chuan_Hoa_NTQLAHS.xlsx!`);
        }
      );
    }

    function copyTableToClipboard() {
      const filtered = getFilteredRecords();
      if (filtered.length === 0) {
        showToast("Chưa có dữ liệu để copy!", true);
        return;
      }
      const headers = [
        "STT", "Mã vụ án", "Tên vụ án", "Cơ quan cảnh sát điều tra", "Tỉnh/Thành", "Giai đoạn",
        "Mã bị can", "Tên bị can", "Ngày sinh", "Số CCCD", "Điều luật", "Trạng thái hồ sơ"
      ];
      const lines = [headers.join("\t")];
      filtered.forEach((r, idx) => {
        lines.push([
          r.stt || idx + 1,
          r.maVuAn,
          r.tenVuAn,
          r.cqdt,
          r.tinhThanh,
          r.giaiDoan,
          r.maBiCan,
          r.tenBiCan,
          r.ngaySinh,
          r.soCccd ? `'${r.soCccd}` : "",
          formatLawDisplay(r.dieuLuat),
          r.trangThai
        ].join("\t"));
      });
      const tsv = lines.join("\r\n");

      const ta = document.createElement("textarea");
      ta.value = tsv;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand("copy");
      document.body.removeChild(ta);
      showToast("Đã copy bảng 12 cột! Bạn có thể mở Excel và nhấn Ctrl+V.");
    }

    async function handleFileSelected(file) {
      if (!file) return;
      document.getElementById("loadedFileName").textContent = `Đã chọn: ${file.name}`;
      await runWithLoading(
        `Đang nạp tập tin: ${file.name}`,
        "Đang giải nén và phân tích cấu trúc bảng tính Excel...",
        async () => {
          let rawRows = [];
          if (file.name.toLowerCase().endsWith(".xlsx")) {
            updateLoadingDetail("Đang giải nén tập tin XLSX và trích xuất dữ liệu ô...");
            const buf = await file.arrayBuffer();
            rawRows = await readXlsxToRowsOffline(buf);
          } else {
            const txt = await file.text();
            rawRows = txt.replace(/\r\n/g, "\n").split("\n").map(line => line.split(/\t|,/));
          }

          updateLoadingDetail(`Đang chuẩn hóa ${rawRows.length:,} dòng & nhận dạng 63 Tỉnh/Thành...`.replace(",", "."));
          await new Promise(r => setTimeout(r, 20));

          const parsed = parseQLAHSRows(rawRows);
          if (parsed.length === 0) {
            showToast("Không tìm thấy cấu trúc hồ sơ hợp lệ (cần có cột Thông tin hồ sơ / Giai đoạn).", true);
            return;
          }
          const append = document.getElementById("chkAppendMode").checked;
          if (append) {
            appState.records = [...appState.records, ...parsed];
            appState.records.forEach((r, idx) => { r.stt = idx + 1; });
          } else {
            appState.records = parsed;
          }

          updateLoadingDetail("Đang hiển thị danh sách hồ sơ và tính toán Pivot Table...");
          await new Promise(r => setTimeout(r, 20));

          renderTable();
          renderPivotTable();
          showToast(`Đã chuẩn hóa thành công ${parsed.length} hồ sơ bị can từ file ${file.name}!`);
        }
      );
    }

    async function parseFromTextarea() {
      const rawText = document.getElementById("pasteInputArea").value;
      if (!rawText.trim()) {
        showToast("Vui lòng dán dữ liệu copy từ Excel hoặc bảng NTQLAHS vào ô trước!", true);
        return;
      }
      await runWithLoading(
        "Đang xử lý dữ liệu dán từ Clipboard",
        "Đang phân tích cấu trúc các dòng dữ liệu...",
        async () => {
          const lines = rawText.replace(/\r\n/g, "\n").split("\n");
          const rawRows = lines.map(ln => {
            if (ln.includes("\t")) return ln.split("\t");
            return ["", ln, "", "", ""];
          });

          updateLoadingDetail(`Đang nhận dạng Tỉnh/Thành & bóc tách ${rawRows.length} dòng...`);
          await new Promise(r => setTimeout(r, 20));

          const parsed = parseQLAHSRows(rawRows);
          if (parsed.length === 0) {
            showToast("Không nhận diện được cấu trúc hồ sơ trong nội dung vừa dán.", true);
            return;
          }
          const append = document.getElementById("chkAppendMode").checked;
          if (append) {
            appState.records = [...appState.records, ...parsed];
            appState.records.forEach((r, idx) => { r.stt = idx + 1; });
          } else {
            appState.records = parsed;
          }

          renderTable();
          renderPivotTable();
          showToast(`Đã phân tích và chuẩn hóa ${parsed.length} hồ sơ bị can!`);
        }
      );
    }

    function downloadRawSampleXlsx() {
      const widths = [8, 38, 32, 36, 18];
      const blob = generateMultiSheetXlsxBlob([
        { name: "Copy_Tu_NTQLAHS", grid: INITIAL_RAW_ROWS, widths: widths, isStandard: false }
      ]);
      triggerDownloadBlob(blob, "File_Mau_Copy_Tu_NTQLAHS.xlsx");
      showToast("Đã tải File_Mau_Copy_Tu_NTQLAHS.xlsx!");
    }

    // =========================================================================
    // 8. KHỞI TẠO SỰ KIỆN TRÊN TRANG
    // =========================================================================
    window.addEventListener("DOMContentLoaded", () => {
      appState.records = parseQLAHSRows(INITIAL_RAW_ROWS);
      renderTable();
      renderPivotTable();

      document.getElementById("pasteInputArea").value = INITIAL_RAW_ROWS.slice(1).map(r => r.join("\t")).join("\n");

      const tabs = [
        { btn: "tabBtnWorkspace", view: "viewWorkspace" },
        { btn: "tabBtnPivot", view: "viewPivot" },
        { btn: "tabBtnCompare", view: "viewCompare" },
        { btn: "tabBtnDesktop", view: "viewDesktop" }
      ];

      function switchTab(targetBtnId) {
        tabs.forEach(t => {
          const b = document.getElementById(t.btn);
          const v = document.getElementById(t.view);
          if (t.btn === targetBtnId) {
            b.className = "tab-active px-3.5 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5";
            v.classList.remove("hidden");
          } else {
            b.className = "px-3.5 py-1.5 rounded-lg text-xs font-semibold text-slate-300 hover:text-white hover:bg-slate-800 transition flex items-center gap-1.5";
            v.classList.add("hidden");
          }
        });
        if (targetBtnId === "tabBtnPivot") {
          renderPivotTable();
        }
      }

      tabs.forEach(t => {
        document.getElementById(t.btn).addEventListener("click", () => switchTab(t.btn));
      });

      document.getElementById("btnQuickGoPivot").addEventListener("click", () => {
        switchTab("tabBtnPivot");
      });

      document.getElementById("presetProvStage").addEventListener("click", () => {
        appState.pivotFullReport = false;
        appState.pivotRowField = "tinhThanh";
        appState.pivotColField = "giaiDoan";
        appState.pivotValueField = "defendants";
        document.getElementById("pivotRowSelect").value = "tinhThanh";
        document.getElementById("pivotColSelect").value = "giaiDoan";
        document.getElementById("pivotValueSelect").value = "defendants";
        renderPivotTable();
      });

      document.getElementById("presetProvStatus").addEventListener("click", () => {
        appState.pivotFullReport = false;
        appState.pivotRowField = "tinhThanh";
        appState.pivotColField = "trangThai";
        appState.pivotValueField = "defendants";
        document.getElementById("pivotRowSelect").value = "tinhThanh";
        document.getElementById("pivotColSelect").value = "trangThai";
        document.getElementById("pivotValueSelect").value = "defendants";
        renderPivotTable();
      });

      document.getElementById("presetFullReport").addEventListener("click", () => {
        appState.pivotFullReport = true;
        renderPivotTable();
      });

      document.getElementById("presetStageStatus").addEventListener("click", () => {
        appState.pivotFullReport = false;
        appState.pivotRowField = "giaiDoan";
        appState.pivotColField = "trangThai";
        appState.pivotValueField = "defendants";
        document.getElementById("pivotRowSelect").value = "giaiDoan";
        document.getElementById("pivotColSelect").value = "trangThai";
        document.getElementById("pivotValueSelect").value = "defendants";
        renderPivotTable();
      });

      document.getElementById("pivotRowSelect").addEventListener("change", (e) => {
        appState.pivotFullReport = false;
        appState.pivotRowField = e.target.value;
        renderPivotTable();
      });
      document.getElementById("pivotColSelect").addEventListener("change", (e) => {
        appState.pivotFullReport = false;
        appState.pivotColField = e.target.value;
        renderPivotTable();
      });
      document.getElementById("pivotValueSelect").addEventListener("change", (e) => {
        appState.pivotFullReport = false;
        appState.pivotValueField = e.target.value;
        renderPivotTable();
      });

      document.getElementById("btnExportPivotXlsx").addEventListener("click", exportPivotToExcel);
      document.getElementById("btnCopyPivotTable").addEventListener("click", copyPivotTableToClipboard);

      const fileInput = document.getElementById("fileInputXlsx");
      fileInput.addEventListener("change", (e) => {
        if (e.target.files && e.target.files[0]) handleFileSelected(e.target.files[0]);
      });
      const dropZone = document.getElementById("dropZone");
      dropZone.addEventListener("dragover", (e) => {
        e.preventDefault();
        dropZone.classList.add("border-blue-600", "bg-blue-100/70");
      });
      dropZone.addEventListener("dragleave", () => {
        dropZone.classList.remove("border-blue-600", "bg-blue-100/70");
      });
      dropZone.addEventListener("drop", (e) => {
        e.preventDefault();
        dropZone.classList.remove("border-blue-600", "bg-blue-100/70");
        if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]) {
          handleFileSelected(e.dataTransfer.files[0]);
        }
      });

      document.getElementById("btnLoadSample").addEventListener("click", () => {
        appState.records = parseQLAHSRows(INITIAL_RAW_ROWS);
        document.getElementById("loadedFileName").textContent = "Đang nạp sẵn: Dữ liệu mẫu (TP.HCM & Hà Tĩnh)";
        renderTable();
        renderPivotTable();
        showToast("Đã khôi phục 2 vụ án mẫu ban đầu!");
      });

      document.getElementById("btnDownloadRawSample").addEventListener("click", downloadRawSampleXlsx);
      document.getElementById("btnParsePaste").addEventListener("click", parseFromTextarea);
      document.getElementById("btnClearPaste").addEventListener("click", () => {
        document.getElementById("pasteInputArea").value = "";
      });

      document.getElementById("chkShortLaw").addEventListener("change", (e) => {
        appState.shortLaw = e.target.checked;
        renderTable();
      });

      document.getElementById("searchFilter").addEventListener("input", (e) => {
        appState.searchQuery = e.target.value;
        renderTable();
      });
      document.getElementById("provinceFilter").addEventListener("change", (e) => {
        appState.provinceFilter = e.target.value;
        renderTable();
      });
      document.getElementById("stageFilter").addEventListener("change", (e) => {
        appState.stageFilter = e.target.value;
        renderTable();
      });
      document.getElementById("statusFilter").addEventListener("change", (e) => {
        appState.statusFilter = e.target.value;
        renderTable();
      });

      document.getElementById("btnAddRow").addEventListener("click", () => {
        const nextStt = appState.records.length + 1;
        appState.records.push({
          id: "rec_" + Date.now(),
          stt: nextStt,
          maVuAn: "VA_",
          tenVuAn: "",
          cqdt: "Công an Thành phố Hồ Chí Minh",
          tinhThanh: "TP. Hồ Chí Minh",
          giaiDoan: "Điều tra",
          maBiCan: "",
          tenBiCan: "",
          ngaySinh: "",
          soCccd: "",
          dieuLuat: "",
          trangThai: "Đình nã"
        });
        renderTable();
        renderPivotTable();
        showToast("Đã thêm 1 dòng trống mới vào cuối bảng.");
      });

      document.getElementById("btnCopyTSV").addEventListener("click", copyTableToClipboard);
      document.getElementById("btnExportXlsx").addEventListener("click", exportStandard12ColsAndPivotXlsx);
      document.getElementById("btnClearAll").addEventListener("click", () => {
        appState.records = [];
        renderTable();
        renderPivotTable();
        showToast("Đã xóa trắng danh sách.");
      });

      fetch("Phan_Mem_Chuan_Hoa_QLAHS_Desktop.py")
        .then(r => r.text())
        .then(code => {
          document.getElementById("pythonCodeBlock").textContent = code;
        })
        .catch(() => {
          document.getElementById("pythonCodeBlock").textContent = "# Xem mã nguồn trong file Phan_Mem_Chuan_Hoa_QLAHS_Desktop.py";
        });

      document.getElementById("btnCopyPythonCode").addEventListener("click", () => {
        const code = document.getElementById("pythonCodeBlock").textContent;
        const ta = document.createElement("textarea");
        ta.value = code;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand("copy");
        document.body.removeChild(ta);
        showToast("Đã copy mã nguồn Python Desktop vào Clipboard!");
      });

      document.getElementById("btnDownloadPythonFile").addEventListener("click", () => {
        const code = document.getElementById("pythonCodeBlock").textContent;
        const blob = new Blob([code], { type: "text/x-python;charset=utf-8" });
        triggerDownloadBlob(blob, "Phan_Mem_Chuan_Hoa_QLAHS_Desktop.py");
        showToast("Đã tải file Phan_Mem_Chuan_Hoa_QLAHS_Desktop.py!");
      });
    });
  </script>
</body>
</html>
