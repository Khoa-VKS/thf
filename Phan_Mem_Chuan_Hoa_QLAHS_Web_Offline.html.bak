              <span>📋</span> Copy Bảng Pivot (Dán Word/Excel)
            </button>
          </div>
        </div>
      </div>

      <!-- Quick Preset Buttons -->
      <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-3">
