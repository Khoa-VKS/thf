<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VIỆN KIỂM SÁT NHÂN DÂN THÀNH PHỐ HỒ CHÍ MINH - Hệ thống Tổng hợp và Xử lý Dữ liệu NTQLAHS</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: #f8fafc;
      color: #0f172a;
    }
    .table-container::-webkit-scrollbar {
      height: 8px;
      width: 8px;
    }
    .table-container::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    .table-container::-webkit-scrollbar-thumb {
      background: #94a3b8;
      border-radius: 4px;
    }
    .cell-edit:focus {
      outline: 2px solid #2563eb;
      background-color: #eff6ff;
    }
    .vks-gradient {
      background: linear-gradient(135deg, #07172c 0%, #0a2540 45%, #153e75 100%);
    }
    .gold-glow {
      box-shadow: 0 0 15px rgba(245, 158, 11, 0.35);
    }
    .tab-active {
      background: linear-gradient(135deg, #b91c1c 0%, #991b1b 100%) !important;
      color: #ffffff !important;
      border-color: #ef4444 !important;
      box-shadow: 0 2px 6px rgba(185, 28, 28, 0.4);
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- ========================================================================= -->
  <!-- TOP NAVIGATION HEADER - VIỆN KIỂM SÁT NHÂN DÂN THÀNH PHỐ HỒ CHÍ MINH     -->
  <!-- ========================================================================= -->
  <header class="vks-gradient text-white border-b-2 border-amber-400 shadow-xl">
    <!-- Top glowing rainbow gold stripe -->
    <div class="h-1.5 bg-gradient-to-r from-amber-500 via-yellow-300 via-rose-500 to-amber-500"></div>

    <div class="max-w-7xl mx-auto px-4 py-3.5 flex flex-wrap items-center justify-between gap-3">
      <!-- Logo & Tiêu đề ngành Kiểm sát TP. Hồ Chí Minh -->
      <div class="flex items-center gap-3.5">
        <!-- Hình ảnh Trụ sở VKSND TP. Hồ Chí Minh -->
        <div class="h-14 w-24 rounded-xl overflow-hidden border-2 border-amber-300 shadow-xl shrink-0 gold-glow bg-slate-900">
          <img src="logo_header_vksnd_tphcm.png" alt="Trụ sở VKSND TP. Hồ Chí Minh" class="w-full h-full object-cover" />
        </div>

        <div>
          <div class="flex items-center gap-2">
            <span class="text-xs sm:text-sm font-extrabold tracking-wide text-amber-300 uppercase flex items-center gap-1.5">
              <span>🏛️</span> VIỆN KIỂM SÁT NHÂN DÂN THÀNH PHỐ HỒ CHÍ MINH
            </span>
            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-500/25 text-emerald-300 border border-emerald-400/40">
              100% Offline Bảo Mật
            </span>
          </div>
          <h1 class="text-base sm:text-xl font-black tracking-tight text-white flex items-center gap-2 mt-0.5">
            HỆ THỐNG TỔNG HỢP VÀ XỬ LÝ DỮ LIỆU NTQLAHS
          </h1>
          <p class="text-xs text-sky-200 mt-0.5">
            Tự động trích xuất Tỉnh/Thành từ CQĐT &bull; Chuẩn hóa 12 trường &bull; Bảng ma trận Pivot Table số người, giai đoạn &amp; trạng thái hồ sơ
          </p>
        </div>
      </div>

      <!-- Slogan Ngành Kiểm Sát + Tab Switcher -->
      <div class="flex flex-col items-end gap-2">
        <!-- Châm ngôn 5 chữ vàng Bác Hồ dạy ngành Kiểm sát -->
        <div class="hidden md:flex items-center gap-1.5 text-[11px] font-bold text-amber-200 bg-red-950/70 px-3.5 py-1 rounded-full border border-amber-400/40 shadow-sm">
          <span class="text-amber-400">★</span>
          <span>Công minh &bull; Chính trực &bull; Khách quan &bull; Thận trọng &bull; Khiêm tốn</span>
          <span class="text-amber-400">★</span>
        </div>

        <!-- View Switcher Tabs -->
        <div class="flex items-center gap-1.5 bg-slate-950/80 p-1.5 rounded-xl border border-slate-700/80 shadow-inner">
          <button id="tabBtnWorkspace" type="button" class="tab-active px-3.5 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5">
            <span>📋</span> Bàn làm việc &amp; Bảng 12 Cột
          </button>
          <button id="tabBtnPivot" type="button" class="px-3.5 py-1.5 rounded-lg text-xs font-bold text-amber-300 hover:text-white hover:bg-slate-800 transition flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
            <span>📊</span> Bảng Pivot Table Tổng Quan
          </button>
          <button id="tabBtnCompare" type="button" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-300 hover:text-white hover:bg-slate-800 transition">
            🔍 Đối chiếu (5 → 12 Cột)
          </button>
          <button id="tabBtnDesktop" type="button" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-300 hover:text-white hover:bg-slate-800 transition">
            💻 Bản Desktop (.py / .exe)
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- Toast Notification -->
  <div id="toastBox" class="fixed bottom-5 right-5 z-50 hidden max-w-md bg-slate-900 text-white px-4 py-3 rounded-xl shadow-2xl border-2 border-amber-400 flex items-center gap-3 text-sm">
    <span id="toastIcon" class="w-3.5 h-3.5 rounded-full bg-emerald-400 shrink-0"></span>
    <span id="toastText" class="font-semibold">Đã xử lý dữ liệu thành công!</span>
  </div>

  <!-- Modal Loading Nổi Bật Cho Dữ Liệu Nặng (Chống Đơ / Treo Trình Duyệt) -->
  <div id="appLoadingModal" class="fixed inset-0 z-50 bg-slate-900/80 backdrop-blur-sm flex items-center justify-center hidden">
    <div class="bg-white rounded-2xl shadow-2xl border-2 border-amber-500 p-6 max-w-md w-full mx-4 text-center transform scale-100">
      <div class="relative w-16 h-16 mx-auto mb-3">
        <div class="w-16 h-16 rounded-full border-4 border-amber-200 border-t-amber-600 animate-spin"></div>
        <div class="absolute inset-0 flex items-center justify-center text-xl">🏛️</div>
      </div>
      <div class="inline-block bg-[#07172C] text-[#F59E0B] text-[11px] font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-2">
        VIỆN KIỂM SÁT NHÂN DÂN TP. HỒ CHÍ MINH
      </div>
      <h3 id="appLoadingTitle" class="text-base font-bold text-slate-900">Đang xử lý dữ liệu hồ sơ QLAHS...</h3>
      <p id="appLoadingDetail" class="text-xs text-slate-600 mt-1.5 font-medium">Hệ thống đang phân tích bóc tách các khối thông tin án...</p>
      
      <!-- Thanh chuyển động Progress bar -->
      <div class="w-full bg-slate-100 rounded-full h-2 mt-4 overflow-hidden border border-slate-200">
        <div class="bg-gradient-to-r from-amber-500 via-blue-700 to-amber-500 h-2 rounded-full w-full animate-pulse"></div>
      </div>
      <p class="text-[11px] text-slate-400 mt-2 italic">Vui lòng đợi trong giây lát, hệ thống đang bóc tách và tính toán...</p>
    </div>
  </div>

  <!-- Main Content Container -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 py-5 space-y-5">

    <!-- ========================================================================= -->
    <!-- TAB 1: WORKSPACE (NHẬP FILE / DÁN & BẢNG 12 CỘT CHUẨN CÓ TỈNH/THÀNH)     -->
    <!-- ========================================================================= -->
    <section id="viewWorkspace" class="space-y-5">

      <!-- 5 KHỐI THẺ KPI MÀU SẮC SINH ĐỘNG -->
      <div class="grid grid-cols-2 sm:grid-cols-5 gap-3.5">
        <!-- Card 1: Bị can (Đỏ Ruby) -->
        <div class="bg-gradient-to-br from-red-50 via-rose-50 to-white rounded-xl p-3.5 border-2 border-rose-300 shadow-sm relative overflow-hidden">
          <div class="flex items-center justify-between">
            <span class="text-xs font-black text-rose-800 uppercase tracking-wider">Tổng số bị can</span>
            <span class="w-6 h-6 rounded-full bg-red-600 text-white text-xs flex items-center justify-center font-bold">👤</span>
          </div>
          <div id="kpiTotal" class="text-3xl font-black text-red-700 mt-1.5">2</div>
          <div class="text-[11px] font-semibold text-rose-600 mt-0.5">Đối tượng đã khởi tố</div>
        </div>

        <!-- Card 2: Vụ án (Xanh Dương Royal) -->
        <div class="bg-gradient-to-br from-blue-50 via-sky-50 to-white rounded-xl p-3.5 border-2 border-blue-300 shadow-sm relative overflow-hidden">
          <div class="flex items-center justify-between">
            <span class="text-xs font-black text-blue-900 uppercase tracking-wider">Số vụ án</span>
            <span class="w-6 h-6 rounded-full bg-blue-600 text-white text-xs flex items-center justify-center font-bold">📁</span>
          </div>
          <div id="kpiCases" class="text-3xl font-black text-blue-800 mt-1.5">2</div>
          <div class="text-[11px] font-semibold text-blue-600 mt-0.5">Theo mã vụ án QLAHS</div>
        </div>

        <!-- Card 3: Tỉnh/Thành (Xanh Ngọc Emerald) -->
        <div class="bg-gradient-to-br from-emerald-50 via-teal-50 to-white rounded-xl p-3.5 border-2 border-emerald-300 shadow-sm relative overflow-hidden">
          <div class="flex items-center justify-between">
            <span class="text-xs font-black text-emerald-900 uppercase tracking-wider">Tỉnh / Thành phố</span>
            <span class="w-6 h-6 rounded-full bg-emerald-600 text-white text-xs flex items-center justify-center font-bold">🏛️</span>
          </div>
          <div id="kpiProvinces" class="text-3xl font-black text-emerald-700 mt-1.5">2</div>
          <div class="text-[11px] font-semibold text-emerald-600 mt-0.5">Nhận dạng từ CQĐT</div>
        </div>

        <!-- Card 4: Giai đoạn (Xanh Mòng Két Teal) -->
        <div class="bg-gradient-to-br from-teal-50 via-cyan-50 to-white rounded-xl p-3.5 border-2 border-teal-300 shadow-sm relative overflow-hidden">
          <div class="flex items-center justify-between">
            <span class="text-xs font-black text-teal-900 uppercase tracking-wider">Giai đoạn tố tụng</span>
            <span class="w-6 h-6 rounded-full bg-teal-600 text-white text-xs flex items-center justify-center font-bold">⚖️</span>
          </div>
          <div id="kpiStages" class="text-xs font-bold text-teal-800 mt-2 truncate">Điều tra: 1 | Sơ thẩm: 1</div>
          <div class="text-[11px] font-medium text-teal-600 mt-1">Khởi tố, ĐT, Truy tố, Xử</div>
        </div>

        <!-- Card 5: Trạng thái (Vàng Cam Hổ Phách Amber) -->
        <div class="bg-gradient-to-br from-amber-50 via-yellow-50 to-white rounded-xl p-3.5 border-2 border-amber-300 shadow-sm relative overflow-hidden">
          <div class="flex items-center justify-between">
            <span class="text-xs font-black text-amber-900 uppercase tracking-wider">Trạng thái hồ sơ</span>
            <span class="w-6 h-6 rounded-full bg-amber-600 text-white text-xs flex items-center justify-center font-bold">🏷️</span>
          </div>
          <div id="kpiStatus" class="text-xs font-bold text-amber-800 mt-2 truncate">Đình nã: 2</div>
          <div class="text-[11px] font-medium text-amber-600 mt-1">Đình nã, Truy nã, Tạm ĐC</div>
        </div>
      </div>

      <!-- Input & Options Panel -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
        <!-- Left: Upload Excel file -->
        <div class="lg:col-span-5 bg-white rounded-2xl border border-slate-200 p-4 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                <span class="w-6 h-6 rounded-lg bg-blue-600 text-white flex items-center justify-center text-xs font-black shadow-sm">1</span>
                Nạp file Excel NTQLAHS (.xlsx)
              </h2>
              <span class="text-[11px] bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full font-bold border border-emerald-300">Offline 100%</span>
            </div>
            <p class="text-xs text-slate-500 mb-3">
              Chọn file Excel trích xuất hoặc copy từ phần mềm QLAHS (kể cả dạng dữ liệu 3-5 dòng bị tách rời).
            </p>
            <label for="fileInputXlsx" id="dropZone" class="border-2 border-dashed border-blue-400 hover:border-blue-600 bg-blue-50/50 hover:bg-blue-100/60 transition rounded-xl p-4 flex flex-col items-center justify-center cursor-pointer text-center">
              <div class="w-10 h-10 rounded-full bg-blue-600 text-white flex items-center justify-center font-black text-lg mb-1.5 shadow-md">
                ↑
              </div>
              <span class="text-xs font-bold text-blue-900">Bấm để chọn file Excel (.xlsx) hoặc kéo thả vào đây</span>
              <span id="loadedFileName" class="text-[11px] text-slate-600 mt-1 font-medium bg-white px-2 py-0.5 rounded border border-slate-200">Đang nạp sẵn: Dữ liệu mẫu (TP.HCM &amp; Hà Tĩnh)</span>
              <input id="fileInputXlsx" type="file" accept=".xlsx,.xls,.csv,.txt" class="hidden" />
            </label>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-2 mt-3 pt-3 border-t border-slate-100">
            <button id="btnLoadSample" type="button" class="text-xs font-bold text-blue-700 hover:text-blue-900 underline flex items-center gap-1">
              <span>↺</span> Nạp lại 2 vụ án mẫu ban đầu
            </button>
            <button id="btnDownloadRawSample" type="button" class="px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 transition">
              Tải File Excel Gốc Mẫu (.xlsx)
            </button>
          </div>
        </div>

        <!-- Right: Direct Paste from Excel or QLAHS Web -->
        <div class="lg:col-span-7 bg-white rounded-2xl border border-slate-200 p-4 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <h2 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                <span class="w-6 h-6 rounded-lg bg-teal-600 text-white flex items-center justify-center text-xs font-black shadow-sm">2</span>
                Dán dữ liệu trực tiếp từ Clipboard (Ctrl+V)
              </h2>
              <span class="text-[11px] bg-teal-100 text-teal-800 px-2 py-0.5 rounded-full font-bold border border-teal-300">Copy từ bảng NTQLAHS</span>
            </div>
            <textarea id="pasteInputArea" rows="4" placeholder="Bôi đen bảng trên phần mềm NTQLAHS -> nhấn Ctrl+C -> bấm vào đây nhấn Ctrl+V rồi nhấn nút 'Phân tích & Chuẩn hóa'..." class="w-full rounded-xl border border-slate-300 p-2.5 text-xs font-mono text-slate-700 focus:ring-2 focus:ring-blue-600 focus:outline-none"></textarea>
          </div>

          <!-- Normalization Rules & Action Buttons -->
          <div class="flex flex-wrap items-center justify-between gap-3 mt-3 pt-2 border-t border-slate-100">
            <div class="flex flex-wrap items-center gap-4 text-xs text-slate-700">
              <label class="inline-flex items-center gap-1.5 cursor-pointer font-medium">
                <input id="chkAppendMode" type="checkbox" class="rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
                <span>Gộp nối tiếp vào danh sách</span>
              </label>
              <label class="inline-flex items-center gap-1.5 cursor-pointer font-medium">
                <input id="chkShortLaw" type="checkbox" class="rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
                <span>Chỉ lấy số Điều luật (VD: Điều 104)</span>
              </label>
            </div>

            <div class="flex items-center gap-2">
              <button id="btnParsePaste" type="button" class="px-4 py-2 rounded-xl text-xs font-black bg-gradient-to-r from-teal-600 to-emerald-700 hover:from-teal-700 hover:to-emerald-800 text-white shadow-md transition flex items-center gap-1.5">
                <span>⚡</span> Phân tích &amp; Chuẩn hóa
              </button>
              <button id="btnClearPaste" type="button" class="px-3 py-2 rounded-xl text-xs font-medium bg-slate-100 hover:bg-slate-200 text-slate-600 transition">
                Xóa ô dán
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Main 12-Column Output Table Card -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-md overflow-hidden">
        <!-- Toolbar -->
        <div class="p-4 border-b border-slate-200 flex flex-wrap items-center justify-between gap-3 bg-gradient-to-r from-slate-50 via-blue-50/30 to-slate-50">
          <div class="flex flex-wrap items-center gap-2.5">
            <div class="flex items-center gap-2 font-black text-slate-900 text-sm">
              <span class="w-3 h-3 rounded-full bg-red-600 animate-ping"></span>
              Bảng Kết Quả Chuẩn Hóa 12 Cột (VKSND TP. Hồ Chí Minh)
            </div>
            <input id="searchFilter" type="text" placeholder="🔍 Tìm bị can, mã vụ, CCCD, CQĐT..." class="px-3 py-1.5 rounded-xl border border-slate-300 text-xs w-56 focus:ring-2 focus:ring-blue-600 focus:outline-none bg-white shadow-sm" />
            
            <!-- Province Filter Dropdown -->
            <select id="provinceFilter" class="px-2.5 py-1.5 rounded-xl border-2 border-sky-300 text-xs bg-sky-50 text-sky-900 font-bold shadow-sm">
              <option value="ALL">🏛️ Tất cả Tỉnh/Thành</option>
            </select>

            <select id="stageFilter" class="px-2.5 py-1.5 rounded-xl border border-slate-300 text-xs bg-white text-slate-700 font-medium">
              <option value="ALL">⚖️ Tất cả giai đoạn</option>
              <option value="Điều tra">Điều tra</option>
              <option value="Truy tố">Truy tố</option>
              <option value="Sơ thẩm">Sơ thẩm</option>
              <option value="Phúc thẩm">Phúc thẩm</option>
            </select>

            <select id="statusFilter" class="px-2.5 py-1.5 rounded-xl border border-slate-300 text-xs bg-white text-slate-700 font-medium">
              <option value="ALL">🏷️ Tất cả trạng thái</option>
              <option value="Đình nã">Đình nã</option>
              <option value="Truy nã">Truy nã</option>
              <option value="Tạm đình chỉ">Tạm đình chỉ</option>
            </select>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <button id="btnQuickGoPivot" type="button" class="px-3.5 py-2 rounded-xl text-xs font-black bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-slate-950 shadow-md transition flex items-center gap-1.5">
              <span>📊</span> Xem Bảng Pivot Table
            </button>
            <button id="btnAddRow" type="button" class="px-3 py-2 rounded-xl text-xs font-semibold bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 transition">
              + Thêm dòng
            </button>
            <button id="btnCopyTSV" type="button" class="px-3.5 py-2 rounded-xl text-xs font-bold bg-blue-50 hover:bg-blue-100 text-blue-900 border border-blue-200 transition">
              Copy Bảng 12 Cột
            </button>
            <button id="btnExportXlsx" type="button" class="px-4 py-2 rounded-xl text-xs font-black bg-gradient-to-r from-red-700 to-rose-800 hover:from-red-800 hover:to-rose-900 text-white shadow-md transition flex items-center gap-1.5">
              <span>📥</span> Xuất Excel (12 Cột &amp; Pivot)
            </button>
            <button id="btnClearAll" type="button" class="px-2.5 py-2 rounded-xl text-xs font-semibold text-rose-600 hover:bg-rose-50 transition">
              Xóa hết
            </button>
          </div>
        </div>

        <!-- 12-Column Table -->
        <div class="table-container overflow-x-auto">
          <table class="w-full text-left border-collapse text-xs">
            <thead>
              <tr class="bg-[#0A2540] text-white font-bold tracking-wide">
                <th class="py-3 px-2 border-r border-slate-700 text-center w-11">STT</th>
                <th class="py-3 px-3 border-r border-slate-700 min-w-[165px]">Mã vụ án</th>
                <th class="py-3 px-3 border-r border-slate-700 min-w-[220px]">Tên vụ án</th>
                <th class="py-3 px-3 border-r border-slate-700 min-w-[180px]">Cơ quan CSĐT</th>
                <th class="py-3 px-3 border-r border-slate-700 text-center min-w-[145px] bg-[#153E75] text-amber-300 font-black">
                  🏛️ Tỉnh / Thành phố
                </th>
                <th class="py-3 px-2.5 border-r border-slate-700 text-center min-w-[100px]">Giai đoạn</th>
                <th class="py-3 px-3 border-r border-slate-700 min-w-[175px]">Mã bị can</th>
                <th class="py-3 px-3 border-r border-slate-700 min-w-[145px]">Tên bị can</th>
                <th class="py-3 px-2.5 border-r border-slate-700 text-center min-w-[95px]">Ngày sinh</th>
                <th class="py-3 px-3 border-r border-slate-700 min-w-[120px]">Số CCCD</th>
                <th class="py-3 px-3 border-r border-slate-700 min-w-[220px]">Điều luật</th>
                <th class="py-3 px-3 border-r border-slate-700 text-center min-w-[120px]">Trạng thái</th>
                <th class="py-3 px-2 text-center w-11">Xóa</th>
              </tr>
            </thead>
            <tbody id="resultTableBody" class="divide-y divide-slate-200">
              <!-- Populated by JS -->
            </tbody>
          </table>
        </div>

        <div class="px-4 py-3 bg-slate-50 border-t border-slate-200 flex flex-wrap items-center justify-between text-xs text-slate-600">
          <span class="flex items-center gap-1.5">
            <span class="text-blue-600 font-bold">💡 Mẹo:</span> Bạn có thể nhấp đúp trực tiếp vào bất kỳ ô nào trên bảng để chỉnh sửa nhanh nội dung trước khi xuất file.
          </span>
